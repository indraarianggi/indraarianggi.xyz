# Example restricted authorized_keys entry for the deploy user.
#
# Append as a single line to /home/deploy/.ssh/authorized_keys, replacing the
# key with the public half of the DEPLOY_SSH_KEY repository secret. Other
# projects may keep their own lines in the same file; append, never overwrite.
#
# rrsync confines the session to the site directory and `-wo` permits writes
# only, so the deploy key cannot read the served files, run commands, open
# tunnels, or touch anything outside this path.
#
# The trailing comment identifies the key, so revoking it is one line:
#   sudo sed -i '/deploy@indraarianggi.xyz$/d' /home/deploy/.ssh/authorized_keys

command="/usr/bin/rrsync -wo /srv/indraarianggi.xyz/site",no-agent-forwarding,no-port-forwarding,no-pty,no-user-rc,no-X11-forwarding ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI_REPLACE_WITH_YOUR_DEPLOY_PUBLIC_KEY deploy@indraarianggi.xyz
