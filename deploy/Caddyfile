# Static origin for indraarianggi.xyz.
#
# Only the Cloudflare Tunnel reaches this service, over the loopback interface.
# TLS terminates at Cloudflare's edge, so this server speaks plain HTTP.

{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	log {
		output stdout
	}

	# Unhashed output (HTML, feed, sitemap) must revalidate after every deploy.
	# Astro writes content-hashed files under /_astro, which can be immutable.
	# The two matchers are mutually exclusive on purpose: Caddy evaluates
	# matcher-scoped header routes before matcher-free ones, so a bare default
	# would overwrite whichever rule it happened to run after.
	@hashed path /_astro/*
	@revalidate not path /_astro/*

	header @revalidate Cache-Control "public, max-age=0, must-revalidate"
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	file_server

	# Astro emits dist/404.html; keep the error status while serving that body.
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
