---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { site } from '../config/site';
import type { TocItem } from '../lib/toc';

type Props = {
  title: string;
  path: string;
  variant?: 'project' | 'article';
  toc?: TocItem[];
};

const { title, path, variant = 'project', toc } = Astro.props;
const hasToc = toc !== undefined && toc.length >= 2;
---

<BaseLayout title={`${title} | ${site.name}`} path={path}>
  <div class="shell">
    <header class:list={['detail-header', `detail-${variant}`]}>
      <div class="header-main">
        <slot name="kicker" />
        <h1 class:list={['detail-title', { 'title-article': variant === 'article' }]}>{title}</h1>
      </div>
      <slot name="metadata" />
    </header>

    {
      hasToc ? (
        <div class="detail-grid">
          <div class="detail-reading">
            <div class="toc-sentinel" data-toc-sentinel aria-hidden="true" />
            <slot />
            <slot name="after-content" />
          </div>
          <div class="detail-rail">
            <TableOfContents tree={toc} />
          </div>
        </div>
      ) : (
        <div class="detail-reading">
          <slot />
          <slot name="after-content" />
        </div>
      )
    }
  </div>
</BaseLayout>


<style>
  .detail-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    gap: 0.5rem;
    margin-block-start: 1.25rem;
  }

  .header-main {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--ink);
    color: var(--surface);
  }

  .detail-title {
    margin: 0;
    font-family: var(--font-poster);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(2.25rem, 4.6vw, 4.125rem);
    line-height: 0.88;
    letter-spacing: -0.04em;
  }

  .title-article {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(2rem, 4.2vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17.5rem;
    gap: 2.5rem;
    align-items: start;
    margin-block-start: 1.5rem;
  }

  .detail-reading {
    min-width: 0;
  }

  .toc-sentinel {
    height: 0;
  }

  .detail-rail {
    min-width: 0;
  }

  @media (max-width: 63.9375rem) {
    .detail-header {
      grid-template-columns: 1fr;
      margin-block-start: 1rem;
    }

    .detail-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
