---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import KineticText from '../components/KineticText.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { site } from '../config/site';
import type { TocItem } from '../lib/toc';

/*
  Detail pages in two acts. The title plays on the stage; then a paper
  sheet rolls up over it for the reading. Where the title card fits on
  screen it stays pinned while the sheet covers it, receding as it goes.
*/
type Props = {
  title: string;
  summary: string;
  path: string;
  variant?: 'project' | 'article';
  toc?: TocItem[];
  cover?: ImageMetadata;
  coverAlt?: string;
  runtimeMinutes?: number;
};

const { title, summary, path, variant = 'project', toc, cover, coverAlt, runtimeMinutes } = Astro.props;
const hasToc = toc !== undefined && toc.length >= 2;
const back = variant === 'article'
  ? { href: '/blog/', label: 'Field notes' }
  : { href: '/work/', label: 'Work index' };
---

<BaseLayout
  title={`${title} | ${site.name}`}
  description={summary}
  path={path}
  image={cover ? { src: cover.src, alt: coverAlt ?? '' } : undefined}
  runtimeMinutes={runtimeMinutes}
>
  <div class="detail">
    <header class="stage-head shell" data-scene="Title">
      <div class="head-copy">
        <p class="head-line label">
          <a class="back text-link" href={back.href}>{back.label}</a>
          <span class="keyframe" aria-hidden="true"></span>
          <span class="dim">{variant === 'article' ? 'Field note' : 'Case study'}</span>
        </p>
        <KineticText as="h1" split="words" text={title} delay={60} class="detail-title display" />
        <p class="head-summary serif">{summary}</p>
      </div>
      <slot name="metadata" />
    </header>

    <div class="sheet paper">
      {
        cover && (
          <div class="shell">
            <figure class="cover">
              <Image src={cover} alt={coverAlt ?? ''} widths={[720, 1200, 1800]} sizes="(min-width: 90rem) 84rem, 100vw" loading="eager" data-drift />
            </figure>
          </div>
        )
      }
      <div class="shell">
        {
          hasToc ? (
            <div class="detail-grid">
              <div class="detail-reading">
                <div class="toc-sentinel" data-toc-sentinel aria-hidden="true" />
                <slot />
              </div>
              <div class="detail-rail">
                <TableOfContents tree={toc} />
              </div>
            </div>
          ) : (
            <div class="detail-reading detail-reading-solo">
              <slot />
            </div>
          )
        }
      </div>
      <slot name="after-content" />
    </div>
  </div>
</BaseLayout>

<style>
  .detail {
    timeline-scope: --sheet;
  }

  .stage-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
    gap: 2rem 3rem;
    align-items: end;
    padding-block: 2rem clamp(3rem, 8vw, 5rem);
    transform-origin: 50% 0;
  }

  .head-copy {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }

  .head-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .stage-head :global(.detail-title) {
    margin: 0;
    font-size: clamp(2.75rem, 7.2vw, 7rem);
    overflow-wrap: anywhere;
  }

  .head-summary {
    max-width: 40ch;
    margin: 0;
    color: var(--dim);
    font-size: clamp(1.125rem, 1.6vw, 1.4375rem);
    line-height: 1.4;
  }

  @media (prefers-reduced-motion: no-preference) {
    .head-summary,
    .stage-head > :global(.clapper) {
      animation: rise var(--dur-std) var(--ease-out) backwards;
      animation-delay: 380ms;
    }
  }

  .sheet {
    position: relative;
    z-index: 1;
    padding-block: clamp(1.5rem, 4vw, 3rem) 0;
    view-timeline: --sheet block;
  }

  .cover {
    margin: 0 0 clamp(2rem, 5vw, 3.5rem);
    aspect-ratio: 21 / 9;
    overflow: clip;
    background: var(--ink);
  }

  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    outline: none;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 56.25rem) 17.5rem;
    gap: 2.125rem;
    align-items: stretch;
    padding-block-end: 4rem;
  }

  .detail-reading {
    min-width: 0;
  }

  .detail-reading-solo {
    max-width: 56.25rem;
    padding-block-end: 4rem;
  }

  .detail-reading :global(.prose) {
    max-width: none;
    font-size: 1.25rem;
    line-height: 1.6;
  }

  .detail-reading :global(.prose > p),
  .detail-reading :global(.prose > ul),
  .detail-reading :global(.prose > ol),
  .detail-reading :global(.prose > blockquote) {
    max-width: 47.5rem;
  }

  .detail-reading :global(.prose > :first-child) {
    margin-block-start: 0;
  }

  .detail-reading :global(.prose h2) {
    font-size: clamp(1.75rem, 3vw, 2.625rem);
  }

  .toc-sentinel {
    height: 0;
  }

  .detail-rail {
    display: grid;
    min-width: 0;
  }

  /* Pin the title card while the sheet rolls over it: wide, tall screens only. */
  @media (min-width: 64rem) and (min-height: 46rem) {
    .stage-head {
      position: sticky;
      top: 0;
      min-height: calc(100svh - 4.5rem - var(--hud-h));
    }
  }

  @supports (animation-timeline: view()) {
    @media (min-width: 64rem) and (min-height: 46rem) and (prefers-reduced-motion: no-preference) {
      .stage-head {
        animation: stage-recede linear both;
        animation-timeline: --sheet;
        animation-range: entry 0% entry 100%;
      }
    }
  }

  @keyframes stage-recede {
    to {
      transform: scale(0.94);
      opacity: 0.25;
    }
  }

  @media (min-width: 48rem) and (max-width: 63.9375rem) {
    .detail-grid {
      grid-template-columns: minmax(0, 1fr) 13rem;
      gap: 1.5rem;
    }
  }

  @media (max-width: 63.9375rem) {
    .stage-head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 47.9375rem) {
    .stage-head {
      padding-block: 1rem 2.5rem;
    }

    .cover {
      aspect-ratio: 4 / 3;
    }

    .detail-grid {
      grid-template-columns: 1fr;
      gap: 0;
      padding-block-end: 2.5rem;
    }

    .detail-reading-solo {
      padding-block-end: 2.5rem;
    }

    .detail-reading :global(.prose) {
      font-size: 1.125rem;
      line-height: 1.55;
    }
  }
</style>
