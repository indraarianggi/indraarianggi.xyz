---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { site } from '../config/site';
import type { TocItem } from '../lib/toc';

type Props = {
  title: string;
  summary: string;
  path: string;
  variant?: 'project' | 'article';
  toc?: TocItem[];
};

const { title, summary, path, variant = 'project', toc } = Astro.props;
const hasToc = toc !== undefined && toc.length >= 2;
---

<BaseLayout title={`${title} | ${site.name}`} path={path}>
  <div class="shell">
    <header class:list={['detail-header', `detail-${variant}`]} data-reveal>
      <div class="header-main">
        <p class="detail-kicker kicker kicker-red">{variant === 'article' ? 'Article / Field notes' : 'Project / Selected work'}</p>
        <h1 class="detail-title">{title}</h1>
        <p class="detail-summary">{summary}</p>
      </div>
      <slot name="metadata" />
    </header>

    {
      hasToc ? (
        <div class="detail-grid">
          <div class="detail-reading">
            <div class="toc-sentinel" data-toc-sentinel aria-hidden="true" />
            <slot />
            <slot name="after-content" />
          </div>
          <div class="detail-rail">
            <TableOfContents tree={toc} />
          </div>
        </div>
      ) : (
        <div class="detail-reading">
          <slot />
          <slot name="after-content" />
        </div>
      )
    }
  </div>
</BaseLayout>


<style>
  .detail-header {
    display: grid;
    grid-template-columns: minmax(0, 920fr) minmax(0, 408fr);
    min-height: 21.875rem;
    border-block-end: 3px solid var(--ink);
  }

  .header-main {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    gap: 1.5rem;
    padding: 1.75rem 1.5rem 1.75rem 0;
    color: var(--ink);
  }

  .detail-kicker {
    margin: 0;
    font-size: 0.625rem;
  }

  .detail-title {
    margin: 0;
    font-family: var(--font-poster);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(2.75rem, 5vw, 4.5rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
  }

  .detail-article .detail-title {
    font-family: var(--font-serif);
    font-weight: 700;
    letter-spacing: -0.03em;
    font-size: clamp(2.5rem, 4.75vw, 4.25rem);
  }

  .detail-summary {
    max-width: 47.5rem;
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    line-height: 1.35;
    text-wrap: pretty;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 56.25rem) 17.5rem;
    gap: 2.125rem;
    align-items: stretch;
    margin-block: 2.75rem 4rem;
  }

  .detail-reading {
    min-width: 0;
  }

  .detail-header + .detail-reading {
    max-width: 56.25rem;
    margin-block: 2.75rem 4rem;
  }

  .detail-reading :global(.prose) {
    max-width: none;
    font-size: 1.25rem;
    line-height: 1.55;
  }

  .detail-reading :global(.prose > p),
  .detail-reading :global(.prose > ul),
  .detail-reading :global(.prose > ol),
  .detail-reading :global(.prose > blockquote) {
    max-width: 47.5rem;
  }

  .detail-reading :global(.prose > :first-child) {
    margin-block-start: 0;
  }

  .detail-reading :global(.prose h2) {
    font-size: clamp(1.75rem, 3vw, 2.625rem);
  }

  .toc-sentinel {
    height: 0;
  }

  .detail-rail {
    min-width: 0;
  }

  @media (min-width: 48rem) and (max-width: 63.9375rem) {
    .detail-grid {
      grid-template-columns: minmax(0, 1fr) 13rem;
      gap: 1.5rem;
    }
  }

  @media (max-width: 47.9375rem) {
    .detail-header {
      grid-template-columns: 1fr;
      min-height: 0;
      border-block-end: 0;
    }

    .header-main {
      gap: 1rem;
      padding: 1rem 0;
    }

    .detail-title {
      font-size: clamp(2.125rem, 11.3vw, 2.75rem);
      line-height: 0.95;
    }

    .detail-article .detail-title {
      font-size: clamp(2rem, 10.3vw, 2.5rem);
    }

    .detail-summary {
      font-size: 1.0625rem;
      line-height: 1.5;
    }

    .detail-grid {
      grid-template-columns: 1fr;
      gap: 0;
      margin-block: 1.5rem 2.5rem;
    }

    .detail-header + .detail-reading {
      margin-block: 1.5rem 2.5rem;
    }

    .detail-reading :global(.prose) {
      font-size: 1.125rem;
      line-height: 1.55;
    }
  }
</style>
