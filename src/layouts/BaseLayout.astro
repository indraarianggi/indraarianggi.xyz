---
import { ClientRouter } from 'astro:transitions';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TimelineHud from '../components/TimelineHud.astro';
import SceneWipe from '../components/SceneWipe.astro';
import '../styles/fonts.css';
import '../styles/global.css';

type Props = {
  title: string;
  description?: string;
  path: string;
  image?: { src: string; alt: string };
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  /** Reading time in minutes; the HUD timecode runs to it. */
  runtimeMinutes?: number;
};

const { title, description, path, image, article, runtimeMinutes } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="theme-color" content="#0c0c0d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Indra Arianggi" href="/rss.xml" />
    <!-- Marks JS as available before first paint, so play-once content is
         only hidden when something will play it. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter />
    <SeoHead title={title} description={description} path={path} image={image} article={article} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />
    <TimelineHud runtimeSeconds={runtimeMinutes ? runtimeMinutes * 60 : undefined} />
    <SceneWipe />
  </body>
</html>

<script>
  // The player: anything marked [data-play] runs its time-based entrance
  // once, when it first reaches the screen.
  let stopPlayer: (() => void) | undefined;

  document.addEventListener('astro:after-swap', () => {
    // The router replaces <html> attributes on every navigation.
    document.documentElement.classList.add('js');
  });

  document.addEventListener('astro:page-load', () => {
    stopPlayer?.();
    const targets = Array.from(document.querySelectorAll<HTMLElement>('[data-play]'));
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-playing');
        observer.unobserve(entry.target);
      }
    }, { rootMargin: '0px 0px -12% 0px' });

    for (const target of targets) {
      // Keyboard users must never tab into something still hidden.
      target.addEventListener('focusin', () => target.classList.add('is-playing'), { once: true });
      observer.observe(target);
    }
    stopPlayer = () => observer.disconnect();
  });

  // Copy buttons on code blocks (added at build time by the Shiki
  // transformer). One delegated listener covers every page the router swaps in.
  const copyResets = new WeakMap<HTMLElement, number>();

  document.addEventListener('click', async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-code-copy]');
    const block = button?.closest('.code-block');
    const code = block?.querySelector('pre code');
    if (!button || !code) return;
    const status = block!.querySelector<HTMLElement>('[data-code-status]');

    let state: 'copied' | 'selected';
    try {
      await navigator.clipboard.writeText(code.textContent ?? '');
      state = 'copied';
    } catch {
      // No clipboard access (plain http, denied permission): select the code
      // so a keyboard copy still works, and say so.
      const range = document.createRange();
      range.selectNodeContents(code);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
      state = 'selected';
    }

    button.dataset.state = state;
    if (status) {
      status.textContent =
        state === 'copied' ? 'Code copied' : 'Could not copy. The code is selected; press Control C or Command C.';
    }
    window.clearTimeout(copyResets.get(button));
    copyResets.set(
      button,
      window.setTimeout(() => {
        delete button.dataset.state;
        if (status) status.textContent = '';
      }, 2000),
    );
  });
</script>
