---
import { ClientRouter, fade } from 'astro:transitions';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/fonts.css';
import '../styles/global.css';

type Props = {
  title: string;
  description?: string;
  path: string;
  image?: { src: string; alt: string };
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
};

const { title, description, path, image, article } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="theme-color" content="#f1efe8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <SeoHead title={title} description={description} path={path} image={image} article={article} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <SiteHeader />

    <main id="main-content" tabindex="-1" transition:animate={fade({ duration: '180ms' })}>
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
