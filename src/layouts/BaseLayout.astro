---
import { ClientRouter } from 'astro:transitions';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TimelineHud from '../components/TimelineHud.astro';
import SceneWipe from '../components/SceneWipe.astro';
import '../styles/fonts.css';
import '../styles/global.css';

type Props = {
  title: string;
  description?: string;
  path: string;
  image?: { src: string; alt: string };
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
};

const { title, description, path, image, article } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="theme-color" content="#0c0c0d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Indra Arianggi" href="/rss.xml" />
    <!-- Marks JS as available before first paint, so play-once content is
         only hidden when something will play it. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter />
    <SeoHead title={title} description={description} path={path} image={image} article={article} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />
    <TimelineHud />
    <SceneWipe />
  </body>
</html>

<script>
  // The player: anything marked [data-play] runs its time-based entrance
  // once, when it first reaches the screen.
  let stopPlayer: (() => void) | undefined;

  document.addEventListener('astro:after-swap', () => {
    // The router replaces <html> attributes on every navigation.
    document.documentElement.classList.add('js');
  });

  document.addEventListener('astro:page-load', () => {
    stopPlayer?.();
    const targets = Array.from(document.querySelectorAll<HTMLElement>('[data-play]'));
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-playing');
        observer.unobserve(entry.target);
      }
    }, { rootMargin: '0px 0px -12% 0px' });

    for (const target of targets) {
      // Keyboard users must never tab into something still hidden.
      target.addEventListener('focusin', () => target.classList.add('is-playing'), { once: true });
      observer.observe(target);
    }
    stopPlayer = () => observer.disconnect();
  });
</script>
