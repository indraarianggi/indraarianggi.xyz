---
import { ClientRouter, fade } from 'astro:transitions';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/fonts.css';
import '../styles/global.css';

type Props = {
  title: string;
  description?: string;
  path: string;
  image?: { src: string; alt: string };
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
};

const { title, description, path, image, article } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="theme-color" content="#f1efe8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <SeoHead title={title} description={description} path={path} image={image} article={article} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <SiteHeader />

    <main id="main-content" tabindex="-1" transition:animate={fade({ duration: '180ms' })}>
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>

<script>
  let cleanupReveals: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    cleanupReveals?.();
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reducedMotion.matches) return;

    const controller = new AbortController();
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    const reveal = (section: Element) => {
      section.classList.remove('reveal-pending');
      observer.unobserve(section);
    };
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) reveal(entry.target);
      }
    }, { threshold: 0.08 });

    for (const section of sections) {
      // Never hide content already on screen, including restored scroll positions.
      if (section.getBoundingClientRect().top < window.innerHeight) continue;
      section.classList.add('reveal-ready', 'reveal-pending');
      observer.observe(section);
      section.addEventListener('focusin', () => reveal(section), { signal: controller.signal });
    }

    reducedMotion.addEventListener('change', () => {
      if (!reducedMotion.matches) return;
      sections.forEach(reveal);
      observer.disconnect();
    }, { signal: controller.signal });

    cleanupReveals = () => {
      observer.disconnect();
      controller.abort();
    };
  });

  document.addEventListener('astro:before-swap', () => {
    cleanupReveals?.();
    cleanupReveals = undefined;
  });
</script>
