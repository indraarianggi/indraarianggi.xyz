---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';

/* One take in the archive. Hover selects it the way a clip is selected on
   a track: an ink fill wipes across from the left. Lives on paper. */
type Props = {
  entry: CollectionEntry<'blog'>;
  index?: number;
  showTopic?: boolean;
};

const { entry, index = 0, showTopic = true } = Astro.props;
---

<li class="take" data-rise style={`--rd: ${index}`}>
  <a class="take-link" href={`/blog/${entry.id}/`} data-wipe-label={entry.data.title}>
    <span class="take-date label">{formatDate(entry.data.date)}</span>
    <span class="take-title">{entry.data.title}</span>
    {showTopic && entry.data.topics.length > 0 && <span class="take-topic label">{entry.data.topics[0]}</span>}
  </a>
</li>

<style>
  .take {
    border-top: 1px solid var(--ink);
  }

  .take:last-child {
    border-bottom: 1px solid var(--ink);
  }

  .take-link {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    min-height: 5.5rem;
    padding: 1rem 0.75rem;
    color: var(--ink);
    text-decoration: none;
    transition: color 260ms ease;
  }

  .take-link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 360ms var(--ease-out);
  }

  .take-date,
  .take-topic {
    color: var(--muted);
    transition: color 260ms ease;
  }

  .take-title {
    font-family: var(--font-display);
    font-weight: 750;
    font-stretch: 106%;
    font-size: clamp(1.125rem, 1.7vw, 1.5rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    transition: transform 360ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .take-link:hover,
    .take-link:hover .take-date,
    .take-link:hover .take-topic {
      color: var(--paper);
    }

    .take-link:hover::before {
      clip-path: inset(0 0 0 0);
    }

    .take-link:hover .take-title {
      transform: translateX(0.75rem);
    }
  }

  .take-link:focus-visible {
    outline-offset: -2px;
  }

  .take-link:active .take-title {
    opacity: 0.7;
  }

  @media (max-width: 47.9375rem) {
    .take-link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.5rem 1rem;
      padding-inline: 0;
    }

    .take-title {
      grid-column: 1 / -1;
      grid-row: 2;
      font-size: 1.1875rem;
    }
  }
</style>
