---
/*
  The end card of a detail page: the next clip, set huge, as one link.
  Hover runs the same signal wipe the page transition uses, so the cut
  starts under the reader's pointer.
*/
type Props = {
  href: string;
  title: string;
  kicker: string;
};

const { href, title, kicker } = Astro.props;
---

<section class="up-next" data-scene="Up next" aria-label="Up next">
  <a class="next-link shell" href={href} data-wipe-label={title}>
    <span class="next-line label">
      <span class="keyframe" aria-hidden="true"></span>
      <span>{kicker}</span>
    </span>
    <span class="next-title display">{title}</span>
  </a>
</section>

<style>
  .up-next {
    background: var(--stage);
    color: var(--chalk);
  }

  .next-link {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(3rem, 10vw, 7rem);
    color: inherit;
    text-decoration: none;
    transition: color 300ms ease;
  }

  .next-link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--signal);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 520ms var(--ease-in-out);
  }

  .next-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .next-title {
    font-size: clamp(2.5rem, 8vw, 7.5rem);
    overflow-wrap: anywhere;
  }

  .next-link:focus-visible {
    outline-offset: -6px;
  }

  @media (hover: hover) and (pointer: fine) {
    .next-link:hover {
      color: var(--ink);
    }

    .next-link:hover::before {
      clip-path: inset(0 0 0 0);
    }

    .next-link:hover .keyframe {
      background: var(--ink);
    }
  }
</style>
