---
import { site } from '../config/site';
---

<footer class="site-footer">
  <ul class="contact" aria-label="Elsewhere">
    {
      site.contact.map((link) => (
        <li>
          <a href={link.href} rel={link.external ? 'me noopener' : undefined}>
            {link.label} <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  /* Desktop keeps contacts in the sidebar. */
  .site-footer {
    display: none;
  }

  @media (max-width: 68.6875rem) {
    .site-footer {
      display: block;
      padding-block: 1.25rem 2rem;
    }
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    /* 44px hit area, laid out at the text's own height. */
    margin-block: -0.84375rem;
    color: var(--muted);
    text-decoration: none;
  }
</style>
