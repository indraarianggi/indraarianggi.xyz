---
import { site } from '../config/site';

const year = new Date().getUTCFullYear();
const links = [
  ...site.secondaryNav,
  ...site.socialLinks,
  { href: '/rss.xml', label: 'RSS' },
];
---

<footer class="end-slate shell">
  <p class="end-name">
    <span class="keyframe" aria-hidden="true"></span>
    {site.name}
  </p>
  <nav aria-label="Secondary">
    <ul class="end-links">
      {
        links.map((item) => (
          <li>
            <a class="end-link label" href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <p class="end-mark label dim">End of reel / {year}</p>
</footer>

<style>
  .end-slate {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.75rem 2rem;
    margin-block-start: auto;
    padding-block: 2rem calc(var(--hud-h) + 2rem);
    border-top: 1px solid var(--line);
  }

  .end-name {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 112%;
    text-transform: uppercase;
  }

  .end-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .end-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--chalk);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.35em;
    transition: text-decoration-color var(--dur-quick) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .end-link:hover {
      text-decoration-color: var(--signal);
    }
  }

  .end-mark {
    margin: 0;
  }

  @media (max-width: 47.9375rem) {
    .end-slate {
      grid-template-columns: 1fr;
      padding-block-end: max(2rem, env(safe-area-inset-bottom));
    }
  }
</style>
