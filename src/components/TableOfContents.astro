---
import { Icon } from 'astro-icon/components';
import type { TocItem } from '../lib/toc';

type Props = {
  tree: TocItem[];
};

const { tree } = Astro.props;

---

<div class="toc-root" data-toc-root>
  <!-- Desktop expanded rail -->
  <nav class="desktop-rail" aria-label="Table of contents" data-toc-rail>
    <div class="rail-header">
      <span class="rail-label label">On this page</span>
      <button
        type="button"
        class="rail-collapse"
        data-toc-collapse
        aria-expanded="true"
        aria-controls="toc-desktop-list"
      >
        <span class="label kicker-red">Hide</span>
        <Icon name="ph:x-bold" size={14} />
      </button>
    </div>
    <ol class="rail-list" id="toc-desktop-list">
      {
        tree.map((item) => (
          <li>
            <a class="rail-link" href={`#${item.slug}`} data-toc-link>
              {item.text}
            </a>
            {item.children.length > 0 && (
              <ul class="rail-children">
                {item.children.map((child) => (
                  <li>
                    <a class="rail-child" href={`#${child.slug}`} data-toc-link>
                      {child.text}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </nav>

  <!-- Edge that traces the rail's outline while it folds -->
  <span class="rail-edge" data-toc-edge aria-hidden="true" hidden></span>

  <!-- Desktop collapsed control -->
  <button
    type="button"
    class="collapsed-rail"
    data-toc-expand
    aria-expanded="false"
    aria-controls="toc-desktop-list"
    hidden
  >
    <Icon name="ph:list-bold" size={22} />
    <span class="collapsed-label" aria-hidden="true">Contents</span>
  </button>

  <!-- Mobile trigger -->
  <button
    type="button"
    class="mobile-trigger"
    data-toc-trigger
    aria-haspopup="dialog"
    aria-label="Open table of contents"
    hidden
  >
    <Icon name="ph:list-bold" size={22} />
  </button>

  <!-- Mobile dialog -->
  <dialog class="mobile-dialog" data-toc-dialog aria-label="Table of contents">
    <header class="dialog-header">
      <span class="label">Table of contents</span>
      <button
        type="button"
        class="dialog-close"
        data-toc-close
        aria-label="Close table of contents"
      >
        <Icon name="ph:x-bold" size={20} />
      </button>
    </header>
    <ol class="dialog-list">
      {
        tree.map((item) => (
          <li>
            <a class="dialog-link" href={`#${item.slug}`} data-toc-link>
              {item.text}
            </a>
            {item.children.length > 0 && (
              <ul>
                {item.children.map((child) => (
                  <li>
                    <a class="dialog-child" href={`#${child.slug}`} data-toc-link>
                      {child.text}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </dialog>
</div>

<style>
  .toc-root {
    display: contents;
  }

  /* ---- Desktop rail (width managed by DetailLayout grid column) ---- */

  /* The rail and its collapsed strip share one cell, so one can fold into
     the other without the column ever changing size. */
  .desktop-rail,
  .collapsed-rail {
    grid-area: 1 / 1;
    align-self: start;
  }

  .desktop-rail {
    z-index: 1;
  }

  /* The clip cuts the rail's own border away, so this frame carries the
     outline during a fold. Sized by script, in step with the clip. */
  .rail-edge {
    position: sticky;
    top: 1.5rem;
    z-index: 2;
    grid-area: 1 / 1;
    align-self: start;
    justify-self: start;
    box-sizing: border-box;
    border: 1px solid var(--ink);
    pointer-events: none;
  }

  .desktop-rail {
    position: sticky;
    top: 1.5rem;
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - 9rem);
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--ink);
  }

  .rail-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 4.25rem;
    padding: 0.5rem 1rem;
    background: var(--ink);
  }

  .rail-label {
    color: var(--surface);
  }
  .rail-collapse {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.5rem;
    padding: 0.5rem 0.75rem;
    background: none;
    border: 0;
    color: var(--red-on-ink);
    cursor: pointer;
  }

  .rail-collapse :global(.kicker-red) {
    color: inherit;
  }

  .rail-list {
    margin: 0;
    padding: 1rem;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .rail-list li {
    margin: 0;
  }

  .rail-link {
    display: block;
    min-height: 2.75rem;
    padding: 0.625rem 0.75rem;
    border-inline-start: 3px solid transparent;
    color: var(--ink);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.8125rem;
    text-decoration: none;
  }

  /* The red fill is a layer behind the text, so hover and active share one
     surface and the fill can grow from the start edge on transform alone. */
  .rail-link,
  .rail-child {
    position: relative;
    isolation: isolate;
  }

  .rail-link::before,
  .rail-child::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--red-soft);
    transform: scaleX(0);
    transform-origin: left;
  }

  .rail-link[data-toc-active]::before,
  .rail-child[data-toc-active]::before {
    transform: scaleX(1);
  }

  .rail-link[data-toc-active] {
    border-inline-start-color: var(--red);
    color: var(--ink);
    font-weight: 700;
  }

  .rail-children {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rail-child {
    display: block;
    min-height: 2.5rem;
    padding: 0.5rem 0.75rem 0.5rem 1.5rem;
    border-inline-start: 3px solid transparent;
    color: var(--ink);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.75rem;
    text-decoration: none;
  }

  .rail-child[data-toc-active] {
    border-inline-start-color: var(--red);
    color: var(--ink);
    font-weight: 600;
  }

  /* ---- Collapsed control (same reserved grid column) ---- */

  .collapsed-rail {
    position: sticky;
    top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 4rem;
    padding: 0.75rem 0;
    background: var(--ink);
    border: 0;
    color: var(--surface);
    cursor: pointer;
  }

  .collapsed-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  /* ---- Mobile trigger ---- */

  .mobile-trigger {
    position: fixed;
    inset-block-end: calc(1.25rem + env(safe-area-inset-bottom));
    inset-inline-end: calc(1.25rem + env(safe-area-inset-right));
    z-index: 30;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: var(--red);
    color: var(--ink);
    border: 0;
    box-shadow: 0.25rem 0.25rem 0 var(--ink);
    cursor: pointer;
  }

  .mobile-trigger[hidden] {
    display: none;
  }

  /* ---- Mobile dialog ---- */

  .mobile-dialog {
    position: fixed;
    inset: auto 0 0 0;
    margin-inline: 0;
    /* <dialog> defaults to fit-content; the sheet spans the screen. */
    inline-size: 100%;
    max-inline-size: none;
    max-height: 70dvh;
    overflow-y: auto;
    padding: 0;
    border: 0;
    border-top: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }

  .mobile-dialog::backdrop {
    background: oklch(0 0 0 / 0.45);
  }

  .dialog-header {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.25rem 1.25rem;
    background: var(--paper);
    border-block-end: 1px solid var(--rule);
  }

  .dialog-close {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: none;
    border: 0;
    color: var(--red-text);
    cursor: pointer;
  }

  .dialog-list {
    margin: 0;
    padding: 0.25rem 0 1.25rem;
    list-style: none;
  }

  .dialog-link {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    padding: 0.5rem 1.25rem;
    border-inline-start: 4px solid transparent;
    color: var(--ink);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .dialog-link[data-toc-active] {
    background: var(--red-soft);
    border-inline-start-color: var(--red);
    color: var(--ink);
    font-weight: 700;
  }

  .dialog-list ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dialog-child {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.5rem 1.25rem 0.5rem 2rem;
    border-inline-start: 4px solid transparent;
    color: var(--ink);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .dialog-child[data-toc-active] {
    background: var(--red-soft);
    border-inline-start-color: var(--red);
    color: var(--ink);
    font-weight: 600;
  }

  /* ---- Motion: the trigger scales in and out instead of popping. The
     sheet itself is animated by the script (it grows out of the trigger). */

  @media (max-width: 47.9375rem) and (prefers-reduced-motion: no-preference) {
    .mobile-trigger {
      transition:
        opacity 200ms var(--ease-out),
        scale 260ms var(--ease-out),
        display 260ms allow-discrete;
    }

    .mobile-trigger[hidden] {
      opacity: 0;
      scale: 0.6;
    }

    @starting-style {
      .mobile-trigger {
        opacity: 0;
        scale: 0.6;
      }
    }

    .mobile-trigger:active {
      scale: 0.96;
      transition-duration: 120ms;
    }
  }

  /* ---- Desktop visibility ---- */

  .mobile-trigger,
  .mobile-dialog {
    display: none;
  }

  @media (max-width: 47.9375rem) {
    .desktop-rail,
    .collapsed-rail {
      display: none;
    }

    .mobile-trigger,
    .mobile-dialog {
      display: revert;
    }

    .mobile-trigger[hidden] {
      display: none;
    }
  }

  /* ---- Desktop rail controls: 150ms opacity/color ---- */

  @media (min-width: 48rem) and (hover: hover) and (pointer: fine) {
    .rail-link,
    .rail-child {
      transition:
        color 150ms var(--ease-out),
        border-color 150ms var(--ease-out);
    }

    /* Drains quickly when the pointer leaves; fills a little slower on the
       way in so the sweep from the start edge reads. */
    .rail-link::before,
    .rail-child::before {
      transition: transform 200ms var(--ease-out);
    }

    .rail-link:hover,
    .rail-child:hover {
      border-inline-start-color: var(--red);
    }

    .rail-link:hover::before,
    .rail-child:hover::before {
      transform: scaleX(1);
      transition-duration: 360ms;
    }

    .rail-collapse,
    .collapsed-rail {
      transition: color 150ms var(--ease-out);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-link,
    .rail-child,
    .rail-link::before,
    .rail-child::before,
    .rail-collapse,
    .collapsed-rail {
      transition: none;
    }
  }
</style>

<style>
  /* Rail width is reserved by the DetailLayout grid column; the collapsed
     control lives in the same column, so the reading measure never moves. */

  @media (min-width: 48rem) {
    .desktop-rail[hidden],
    .collapsed-rail[hidden] {
      display: none;
    }
  }
</style>

<script>
  // One IntersectionObserver instance per page, re-created on navigation.
  // Guards a component data flag so a second bundle execution is a no-op.
  const state = {
    observer: undefined as IntersectionObserver | undefined,
    cleanup: undefined as (() => void) | undefined,
  };

  function disconnect() {
    state.observer?.disconnect();
    state.observer = undefined;
    state.cleanup?.();
    state.cleanup = undefined;
  }

  function headingTargets(root: HTMLElement): Element[] {
    return [...root.querySelectorAll('[data-toc-link]')]
      .map((link) => document.getElementById(decodeURIComponent((link as HTMLAnchorElement).hash.slice(1))))
      .filter((el): el is HTMLElement => el !== null);
  }

  function init() {
    disconnect();

    const root = document.querySelector<HTMLElement>('[data-toc-root]');
    if (!root) return;

    const sentinel = document.querySelector<HTMLElement>('[data-toc-sentinel]');
    const trigger = root.querySelector<HTMLElement>('[data-toc-trigger]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-toc-dialog]');
    const rail = root.querySelector<HTMLElement>('[data-toc-rail]');
    const collapseButton = root.querySelector<HTMLButtonElement>('[data-toc-collapse]');
    const expandButton = root.querySelector<HTMLButtonElement>('[data-toc-expand]');
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const mobileViewport = window.matchMedia('(max-width: 47.9375rem)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (links.length === 0) return;

    // One observer, two roles: heading tracking and the mobile sentinel.
    state.observer = new IntersectionObserver(
      (entries) => {
        // Sentinel: reveal the mobile trigger only after the intro scrolls out.
        for (const entry of entries) {
          if (entry.target === sentinel) {
            if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
              trigger?.removeAttribute('hidden');
            } else {
              trigger?.setAttribute('hidden', '');
            }
          }
        }

        // Headings: topmost intersecting heading becomes the active section.
        const active = entries
          .filter((entry) => entry.isIntersecting && entry.target !== sentinel)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!active) return;
        const id = active.target.id;
        for (const link of links) {
          const isActive = link.hash === `#${id}`;
          if (isActive) {
            link.setAttribute('aria-current', 'location');
            link.setAttribute('data-toc-active', '');
          } else {
            link.removeAttribute('aria-current');
            link.removeAttribute('data-toc-active');
          }
        }
      },
      { rootMargin: '0px 0px -75% 0px', threshold: 0 },
    );

    for (const heading of headingTargets(root)) {
      state.observer.observe(heading);
    }
    if (sentinel) {
      state.observer.observe(sentinel);
    }

    // Desktop rail collapse/expand. The reserved grid column means the body
    // measure never changes; only the control inside the column changes width.
    // The rail folds into the collapsed strip and unfolds out of it. Both
    // share one grid cell with the rail on top, so during the move the rail
    // is clipped down to the strip's corner and the strip shows beneath it.
    // An edge frame follows the clip so the folding panel keeps its outline.
    const edge = root.querySelector<HTMLElement>('[data-toc-edge]');
    const easeInOut =
      getComputedStyle(document.documentElement).getPropertyValue('--ease-in-out').trim() || 'ease-in-out';
    let running: Animation[] = [];

    // Only the right and bottom insets move; the top-left corner is fixed.
    type Inset = { right: number; bottom: number };
    const open: Inset = { right: 0, bottom: 0 };
    const toClip = ({ right, bottom }: Inset) => `inset(0px ${right}px ${bottom}px 0px)`;
    const fromClip = (clip: string): Inset => {
      // Computed inset() drops repeated values: "inset(0px)", "inset(0px 5px)".
      const [top = 0, right = top, bottom = top] = (clip.match(/-?[\d.]+/g) ?? []).map(Number);
      return { right, bottom };
    };

    const setCollapsed = (collapsed: boolean) => {
      collapseButton?.setAttribute('aria-expanded', String(!collapsed));
      expandButton?.setAttribute('aria-expanded', String(!collapsed));
      if (!rail || !expandButton) return;

      // Interrupted mid-fold: start from where the clip is now.
      const current = running.length > 0 ? getComputedStyle(rail).clipPath : 'none';
      running.forEach((animation) => animation.cancel());
      running = [];

      rail.removeAttribute('hidden');
      expandButton.removeAttribute('hidden');
      const settle = () => {
        (collapsed ? rail : expandButton).setAttribute('hidden', '');
        edge?.setAttribute('hidden', '');
      };
      if (reducedMotion.matches) return settle();

      // Strip width by header height: both ink, so the hand-off is seamless.
      const box = rail.getBoundingClientRect();
      const strip = expandButton.getBoundingClientRect();
      const head = rail.querySelector('.rail-header')!.getBoundingClientRect();
      const corner: Inset = { right: box.width - strip.width, bottom: box.height - head.height };
      const from = current !== 'none' ? fromClip(current) : collapsed ? open : corner;
      const to = collapsed ? corner : open;
      const timing: KeyframeAnimationOptions = {
        duration: collapsed ? 280 : 360,
        easing: easeInOut,
        fill: 'forwards',
      };

      const fold = rail.animate({ clipPath: [toClip(from), toClip(to)] }, timing);
      running = [fold];

      if (edge) {
        edge.removeAttribute('hidden');
        running.push(
          edge.animate(
            {
              width: [`${box.width - from.right}px`, `${box.width - to.right}px`],
              height: [`${box.height - from.bottom}px`, `${box.height - to.bottom}px`],
            },
            timing,
          ),
        );
      }

      // The list clears before the fold reaches it, and returns once there is room.
      const fade = rail.querySelector('.rail-list')?.animate(
        { opacity: collapsed ? [1, 0] : [0, 1] },
        collapsed
          ? { duration: 140, easing: 'ease-out', fill: 'forwards' }
          : { duration: 220, delay: 140, easing: 'ease-out', fill: 'backwards' },
      );
      if (fade) running.push(fade);

      fold.finished
        .then(() => {
          settle();
          running.forEach((animation) => animation.cancel());
          running = [];
        })
        .catch(() => {
          // Cancelled by a newer toggle, which owns the end state.
        });
    };

    collapseButton?.addEventListener('click', () => {
      setCollapsed(true);
      expandButton?.focus();
    });
    expandButton?.addEventListener('click', () => {
      setCollapsed(false);
      collapseButton?.focus();
    });
    // Mobile dialog behavior. Scroll locks only while the dialog is open.
    const lockScroll = (locked: boolean) => {
      document.documentElement.style.overflow = locked ? 'hidden' : '';
    };

    // Focus returns to the control used to open the sheet. Opening scrolls the
    // page and can hide the trigger again, so remember the open context.
    let openedFromTrigger = false;
    // A jump moves focus to its heading, so closing must not pull it back.
    let jumped = false;

    // Section jumps glide instead of cutting. Astro's router would jump
    // instantly; it skips clicks that are already prevented. Modified clicks
    // (new tab, copy link) keep the browser default.
    for (const link of links) {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        if (!target) return;
        event.preventDefault();

        const focusTarget = () => {
          if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: true });
        };

        history.pushState(history.state, '', link.hash);

        // Unlock before scrolling: a late unlock from the close would
        // interrupt the smooth scroll. The page stays inert until the sheet
        // has folded away, so focus moves after the close.
        if (dialog?.open) {
          jumped = true;
          lockScroll(false);
          void closeSheet().then(focusTarget);
        } else {
          focusTarget();
        }

        target.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth', block: 'start' });
      });
    }

    // The sheet grows out of the trigger and folds back into it, so button and
    // sheet read as one object: a red square the size of the trigger opens
    // into the paper sheet, and closing lands it back on the button.
    const cssVar = (name: string, fallback: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;
    const sheetEaseOut = cssVar('--ease-out', 'ease-out');
    const sheetEaseInOut = cssVar('--ease-in-out', 'ease-in-out');
    const sheetFull = 'inset(0px 0px 0px 0px)';
    let sheetAnimations: Animation[] = [];
    let closing: Promise<void> | undefined;

    // The trigger's box in the sheet's coordinates. With no trigger on
    // screen, the sheet folds down into the bottom edge instead.
    const triggerClip = () => {
      const sheet = dialog!.getBoundingClientRect();
      const button = trigger?.getBoundingClientRect();
      if (!button || button.width === 0) return 'inset(100% 0px 0px 0px)';
      const top = Math.max(0, button.top - sheet.top);
      const right = Math.max(0, sheet.right - button.right);
      const bottom = Math.max(0, sheet.bottom - button.bottom);
      const left = Math.max(0, button.left - sheet.left);
      return `inset(${top}px ${right}px ${bottom}px ${left}px)`;
    };

    const sheetParts = () =>
      dialog ? [...dialog.querySelectorAll<HTMLElement>('.dialog-header, .dialog-list > li')] : [];

    // Safari may not animate ::backdrop from script; it then simply appears.
    const animateBackdrop = (opacity: number[], options: KeyframeAnimationOptions) => {
      try {
        return dialog!.animate({ opacity }, { ...options, pseudoElement: '::backdrop' });
      } catch {
        return undefined;
      }
    };

    const stopSheet = () => {
      sheetAnimations.forEach((animation) => animation.cancel());
      sheetAnimations = [];
    };

    const openSheet = () => {
      if (!dialog || dialog.open) return;
      openedFromTrigger = true;
      dialog.showModal();
      lockScroll(true);
      if (reducedMotion.matches) return;

      stopSheet();
      const paper = getComputedStyle(dialog).backgroundColor;
      const red = trigger ? getComputedStyle(trigger).backgroundColor : paper;
      sheetAnimations = [
        dialog.animate({ clipPath: [triggerClip(), sheetFull] }, { duration: 420, easing: sheetEaseOut }),
        dialog.animate({ backgroundColor: [red, paper] }, { duration: 220, easing: 'ease-out' }),
        ...sheetParts().map((part, i) =>
          part.animate(
            { opacity: [0, 1], translate: ['0 0.5rem', '0 0'] },
            { duration: 280, delay: 160 + i * 35, easing: sheetEaseOut, fill: 'backwards' },
          ),
        ),
      ];
      const backdrop = animateBackdrop([0, 1], { duration: 300, easing: 'ease-out' });
      if (backdrop) sheetAnimations.push(backdrop);
    };

    // Every way out (close button, backdrop, Escape, a link) runs through here,
    // because dialog.close() alone would cut the sheet off instantly.
    const closeSheet = (): Promise<void> => {
      if (!dialog?.open) return Promise.resolve();
      if (closing) return closing;
      if (reducedMotion.matches) {
        dialog.close();
        return Promise.resolve();
      }

      // Closing mid-open folds back from wherever the sheet has reached.
      const current = getComputedStyle(dialog).clipPath;
      const from = current === 'none' ? sheetFull : current;
      const paper = getComputedStyle(dialog).backgroundColor;
      const red = trigger ? getComputedStyle(trigger).backgroundColor : paper;
      stopSheet();

      const fold = dialog.animate(
        { clipPath: [from, triggerClip()] },
        { duration: 300, easing: sheetEaseInOut, fill: 'forwards' },
      );
      sheetAnimations = [
        fold,
        dialog.animate({ backgroundColor: [paper, red] }, { duration: 140, delay: 160, easing: 'ease-in', fill: 'forwards' }),
        ...sheetParts().map((part) =>
          part.animate({ opacity: [1, 0] }, { duration: 120, easing: 'ease-out', fill: 'forwards' }),
        ),
      ];
      const backdrop = animateBackdrop([1, 0], { duration: 300, easing: 'ease-out', fill: 'forwards' });
      if (backdrop) sheetAnimations.push(backdrop);

      closing = fold.finished
        .then(() => {
          dialog.close();
          stopSheet();
        })
        .catch(() => {
          // Cancelled by a cleanup that already closed the sheet.
        })
        .finally(() => {
          closing = undefined;
        });
      return closing;
    };

    trigger?.addEventListener('click', openSheet);

    root.querySelector('[data-toc-close]')?.addEventListener('click', () => {
      void closeSheet();
    });

    // Escape: hold the browser's instant close and fold the sheet instead.
    dialog?.addEventListener('cancel', (event) => {
      event.preventDefault();
      void closeSheet();
    });

    // Backdrop interaction: a click on the dialog itself is outside the sheet.
    dialog?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.closest('a')) {
        void closeSheet();
      }
    });

    dialog?.addEventListener('close', () => {
      lockScroll(false);
      if (jumped) {
        jumped = false;
      } else if (mobileViewport.matches && openedFromTrigger) {
        trigger?.focus();
      } else {
        (rail?.hidden ? expandButton : collapseButton)?.focus();
      }
      openedFromTrigger = false;
    });

    const onViewportChange = () => {
      if (!mobileViewport.matches && dialog?.open) {
        stopSheet();
        dialog.close();
      }
    };
    mobileViewport.addEventListener('change', onViewportChange);
    state.cleanup = () => {
      mobileViewport.removeEventListener('change', onViewportChange);
      stopSheet();
      if (dialog?.open) dialog.close();
      lockScroll(false);
    };
  }

  document.addEventListener('astro:page-load', () => {
    init();
  });

  document.addEventListener('astro:before-swap', () => {
    disconnect();
  });
</script>
