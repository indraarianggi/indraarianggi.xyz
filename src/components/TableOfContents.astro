---
import { Icon } from 'astro-icon/components';
import type { TocItem } from '../lib/toc';

type Props = {
  tree: TocItem[];
};

const { tree } = Astro.props;

---

<div class="toc-root" data-toc-root>
  <!-- Desktop expanded rail -->
  <nav class="desktop-rail" aria-label="Table of contents" data-toc-rail>
    <div class="rail-header">
      <span class="rail-label kicker">On this page</span>
      <button
        type="button"
        class="rail-collapse"
        data-toc-collapse
        aria-expanded="true"
        aria-controls="toc-desktop-list"
      >
        <span class="kicker kicker-red">Hide</span>
        <Icon name="ph:x-bold" size={14} />
      </button>
    </div>
    <ol class="rail-list" id="toc-desktop-list">
      {
        tree.map((item) => (
          <li>
            <a class="rail-link" href={`#${item.slug}`} data-toc-link>
              {item.text}
            </a>
            {item.children.length > 0 && (
              <ul class="rail-children">
                {item.children.map((child) => (
                  <li>
                    <a class="rail-child" href={`#${child.slug}`} data-toc-link>
                      {child.text}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </nav>

  <!-- Desktop collapsed control -->
  <button
    type="button"
    class="collapsed-rail"
    data-toc-expand
    aria-expanded="false"
    aria-controls="toc-desktop-list"
    hidden
  >
    <Icon name="ph:list-bold" size={22} />
    <span class="collapsed-label" aria-hidden="true">Contents</span>
  </button>

  <!-- Mobile trigger -->
  <button
    type="button"
    class="mobile-trigger"
    data-toc-trigger
    aria-haspopup="dialog"
    aria-label="Open table of contents"
    hidden
  >
    <Icon name="ph:list-bold" size={22} />
  </button>

  <!-- Mobile dialog -->
  <dialog class="mobile-dialog" data-toc-dialog aria-label="Table of contents">
    <header class="dialog-header">
      <span class="kicker">Table of contents</span>
      <button
        type="button"
        class="dialog-close"
        data-toc-close
        aria-label="Close table of contents"
      >
        <Icon name="ph:x-bold" size={20} />
      </button>
    </header>
    <ol class="dialog-list">
      {
        tree.map((item) => (
          <li>
            <a class="dialog-link" href={`#${item.slug}`} data-toc-link>
              {item.text}
            </a>
            {item.children.length > 0 && (
              <ul>
                {item.children.map((child) => (
                  <li>
                    <a class="dialog-child" href={`#${child.slug}`} data-toc-link>
                      {child.text}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </dialog>
</div>

<style>
  .toc-root {
    display: contents;
  }

  /* ---- Desktop rail (width managed by DetailLayout grid column) ---- */

  .desktop-rail {
    position: sticky;
    top: 1.5rem;
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - 9rem);
    overflow-y: auto;
  }

  .rail-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block-end: 0.75rem;
  }

  .rail-label {
    color: var(--ink);
  }
  .rail-collapse {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.5rem;
    padding: 0.5rem 0.75rem;
    background: none;
    border: 0;
    color: var(--red);
    cursor: pointer;
  }

  .rail-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .rail-list li {
    margin: 0;
  }

  .rail-link {
    display: block;
    min-height: 2.75rem;
    padding: 0.625rem 0.75rem;
    border-inline-start: 3px solid transparent;
    color: var(--ink);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .rail-link[data-toc-active] {
    background: var(--red-soft);
    border-inline-start-color: var(--red);
    color: var(--ink);
    font-weight: 700;
  }

  .rail-children {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rail-child {
    display: block;
    min-height: 2.5rem;
    padding: 0.5rem 0.75rem 0.5rem 1.5rem;
    border-inline-start: 3px solid transparent;
    color: var(--ink);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.75rem;
    text-decoration: none;
  }

  .rail-child[data-toc-active] {
    background: var(--red-soft);
    border-inline-start-color: var(--red);
    color: var(--ink);
    font-weight: 600;
  }

  /* ---- Collapsed control (same reserved grid column) ---- */

  .collapsed-rail {
    position: sticky;
    top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 4rem;
    padding: 0.75rem 0;
    background: var(--ink);
    border: 0;
    color: var(--surface);
    cursor: pointer;
  }

  .collapsed-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  /* ---- Mobile trigger ---- */

  .mobile-trigger {
    position: fixed;
    inset-block-end: calc(1.25rem + env(safe-area-inset-bottom));
    inset-inline-end: calc(1.25rem + env(safe-area-inset-right));
    z-index: 30;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: var(--red);
    color: var(--surface);
    border: 0;
    box-shadow: 0.25rem 0.25rem 0 var(--ink);
    cursor: pointer;
  }

  .mobile-trigger[hidden] {
    display: none;
  }

  /* ---- Mobile dialog ---- */

  .mobile-dialog {
    position: fixed;
    inset: auto 0 0 0;
    margin-inline: 0;
    max-inline-size: none;
    max-height: 70dvh;
    overflow-y: auto;
    padding: 0;
    border: 0;
    border-top: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }

  .mobile-dialog::backdrop {
    background: oklch(0 0 0 / 0.45);
  }

  .dialog-header {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.25rem 1.25rem;
    background: var(--paper);
    border-block-end: 1px solid var(--rule);
  }

  .dialog-close {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: none;
    border: 0;
    color: var(--red);
    cursor: pointer;
  }

  .dialog-list {
    margin: 0;
    padding: 0.25rem 0 1.25rem;
    list-style: none;
  }

  .dialog-link {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    padding: 0.5rem 1.25rem;
    border-inline-start: 4px solid transparent;
    color: var(--ink);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .dialog-link[data-toc-active] {
    background: var(--red-soft);
    border-inline-start-color: var(--red);
    color: var(--ink);
    font-weight: 700;
  }

  .dialog-list ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dialog-child {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.5rem 1.25rem 0.5rem 2rem;
    border-inline-start: 4px solid transparent;
    color: var(--ink);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .dialog-child[data-toc-active] {
    background: var(--red-soft);
    border-inline-start-color: var(--red);
    color: var(--ink);
    font-weight: 600;
  }

  /* ---- Motion: dialog 220ms opacity + 8px rise ---- */

  .mobile-dialog[open] {
    animation: dialog-in 220ms var(--ease-out);
  }

  @keyframes dialog-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }

  /* ---- Desktop visibility ---- */

  .mobile-trigger,
  .mobile-dialog {
    display: none;
  }

  @media (max-width: 63.9375rem) {
    .desktop-rail,
    .collapsed-rail {
      display: none;
    }

    .mobile-trigger,
    .mobile-dialog {
      display: revert;
    }

    .mobile-trigger[hidden] {
      display: none;
    }
  }

  /* ---- Desktop rail controls: 150ms opacity/color ---- */

  @media (min-width: 64rem) {
    .rail-link,
    .rail-child {
      transition:
        color 150ms var(--ease-out),
        background-color 150ms var(--ease-out),
        border-color 150ms var(--ease-out);
    }

    .rail-link:hover,
    .rail-child:hover {
      text-decoration: underline;
      text-decoration-color: var(--red);
      text-decoration-thickness: 1px;
    }

    .rail-collapse,
    .collapsed-rail {
      transition: color 150ms var(--ease-out);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-dialog[open] {
      animation: none;
    }
  }
</style>

<style>
  /* Rail width is reserved by the DetailLayout grid column; the collapsed
     control lives in the same column, so the reading measure never moves. */

  @media (min-width: 64rem) {
    .collapsed-rail[hidden] {
      display: none;
    }
  }
</style>

<script>
  // One IntersectionObserver instance per page, re-created on navigation.
  // Guards a component data flag so a second bundle execution is a no-op.
  const state = {
    observer: undefined as IntersectionObserver | undefined,
  };

  function disconnect() {
    state.observer?.disconnect();
    state.observer = undefined;
  }

  function headingTargets(root: HTMLElement): Element[] {
    return [...root.querySelectorAll('[data-toc-link]')]
      .map((link) => document.getElementById(decodeURIComponent((link as HTMLAnchorElement).hash.slice(1))))
      .filter((el): el is HTMLElement => el !== null);
  }

  function init() {
    disconnect();

    const root = document.querySelector<HTMLElement>('[data-toc-root]');
    if (!root) return;

    const sentinel = document.querySelector<HTMLElement>('[data-toc-sentinel]');
    const trigger = root.querySelector<HTMLElement>('[data-toc-trigger]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-toc-dialog]');
    const rail = root.querySelector<HTMLElement>('[data-toc-rail]');
    const collapseButton = root.querySelector<HTMLButtonElement>('[data-toc-collapse]');
    const expandButton = root.querySelector<HTMLButtonElement>('[data-toc-expand]');
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];

    if (links.length === 0) return;

    // One observer, two roles: heading tracking and the mobile sentinel.
    state.observer = new IntersectionObserver(
      (entries) => {
        // Sentinel: reveal the mobile trigger only after the intro scrolls out.
        for (const entry of entries) {
          if (entry.target === sentinel) {
            if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
              trigger?.removeAttribute('hidden');
            } else {
              trigger?.setAttribute('hidden', '');
            }
          }
        }

        // Headings: topmost intersecting heading becomes the active section.
        const active = entries
          .filter((entry) => entry.isIntersecting && entry.target !== sentinel)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!active) return;
        const id = active.target.id;
        for (const link of links) {
          const isActive = link.hash === `#${id}`;
          if (isActive) {
            link.setAttribute('aria-current', 'location');
            link.setAttribute('data-toc-active', '');
          } else {
            link.removeAttribute('aria-current');
            link.removeAttribute('data-toc-active');
          }
        }
      },
      { rootMargin: '0px 0px -75% 0px', threshold: 0 },
    );

    for (const heading of headingTargets(root)) {
      state.observer.observe(heading);
    }
    if (sentinel) {
      state.observer.observe(sentinel);
    }

    // Desktop rail collapse/expand. The reserved grid column means the body
    // measure never changes; only the control inside the column changes width.
    const setCollapsed = (collapsed: boolean) => {
      collapseButton?.setAttribute('aria-expanded', String(!collapsed));
      expandButton?.setAttribute('aria-expanded', String(collapsed));
      if (collapsed) {
        rail?.setAttribute('hidden', '');
        expandButton?.removeAttribute('hidden');
      } else {
        rail?.removeAttribute('hidden');
        expandButton?.setAttribute('hidden', '');
      }
    };

    collapseButton?.addEventListener('click', () => {
      setCollapsed(true);
      expandButton?.focus();
    });
    expandButton?.addEventListener('click', () => {
      setCollapsed(false);
      collapseButton?.focus();
    });
    // Mobile dialog behavior. Scroll locks only while the dialog is open.
    const lockScroll = (locked: boolean) => {
      document.documentElement.style.overflow = locked ? 'hidden' : '';
    };

    trigger?.addEventListener('click', () => {
      dialog?.showModal();
      lockScroll(true);
    });

    root.querySelector('[data-toc-close]')?.addEventListener('click', () => {
      dialog?.close();
    });

    // Backdrop interaction: a click on the dialog itself is outside the sheet.
    dialog?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.closest('a')) {
        dialog?.close();
      }
    });

    dialog?.addEventListener('close', () => {
      lockScroll(false);
      trigger?.focus();
    });
  }

  document.addEventListener('astro:page-load', () => {
    init();
  });

  document.addEventListener('astro:before-swap', () => {
    disconnect();
  });
</script>
