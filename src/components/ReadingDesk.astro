---
import type { CollectionEntry } from 'astro:content';
import EmptyState from './EmptyState.astro';

/* Compact reading record for the home page. Lives on paper. */
type Props = {
  current: CollectionEntry<'books'>[];
  finished: CollectionEntry<'books'>[];
};

const { current, finished } = Astro.props;
const shelves = [
  { label: 'Reading now', entries: current },
  { label: 'Finished', entries: finished },
].filter((shelf) => shelf.entries.length > 0);
---

<section class="desk" aria-labelledby="reading-desk-title" data-play>
  <p class="desk-line label" data-rise>
    <span class="keyframe" aria-hidden="true"></span>
    <span>Reading desk</span>
  </p>
  <h3 class="desk-title display" id="reading-desk-title" data-rise style="--rd: 1">Books that hold my interest</h3>

  {
    shelves.length > 0 ? (
      shelves.map((shelf, s) => (
        <div class="shelf" data-rise style={`--rd: ${s + 2}`}>
          <p class="shelf-label label">{shelf.label}</p>
          <ul class="book-list">
            {shelf.entries.map((book) => (
              <li class="book">
                <p class="book-title">{book.data.title}</p>
                <p class="book-author dim">{book.data.author}</p>
              </li>
            ))}
          </ul>
        </div>
      ))
    ) : (
      <div data-rise style="--rd: 2">
        <EmptyState message="No books recorded here yet. The shelf fills as I finish them." />
      </div>
    )
  }
  <a class="desk-link label" href="/read/">Visit the reading desk</a>
</section>

<style>
  .desk {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--ink);
  }

  .desk-line {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    color: var(--muted);
  }

  .desk-title {
    margin: 0;
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
  }

  .shelf-label {
    margin: 0 0 0.5rem;
    color: var(--red-text);
  }

  .book-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .book {
    padding-block: 0.75rem;
    border-top: 1px solid var(--rule);
  }

  .book p {
    margin: 0;
  }

  .book-title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .book-author {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
  }

  .desk-link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 2.75rem;
    margin-top: auto;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.35em;
    transition: text-decoration-color var(--dur-quick) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .desk-link:hover {
      text-decoration-color: var(--ink);
    }
  }
</style>
