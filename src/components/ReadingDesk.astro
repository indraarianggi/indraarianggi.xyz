---
import type { CollectionEntry } from 'astro:content';
import EmptyState from './EmptyState.astro';

type Props = {
  current: CollectionEntry<'books'>[];
  finished: CollectionEntry<'books'>[];
};

const { current, finished } = Astro.props;
const hasBooks = current.length > 0 || finished.length > 0;

const bookStatusLabels = {
  reading: 'Reading now',
  finished: 'Finished',
  paused: 'Paused',
  'want-to-read': 'Want to read',
} as const;
---

<section class="desk" aria-labelledby="reading-desk-title">
  <p class="desk-kicker kicker">Reading desk / open</p>
  <h3 class="desk-title poster-section" id="reading-desk-title">Books that hold my interest</h3>

  {
    hasBooks ? (
      <>
        {current.length > 0 && (
          <div class="shelf">
            <p class="shelf-label kicker kicker-red">Reading now</p>
            <ul class="book-list">
              {current.map((book) => (
                <li class="book">
                  <p class="book-status kicker kicker-red">{bookStatusLabels[book.data.status]}</p>
                  <p class="book-title">{book.data.title}</p>
                  <p class="book-author">{book.data.author}</p>
                </li>
              ))}
            </ul>
          </div>
        )}
        {finished.length > 0 && (
          <div class="shelf">
            <p class="shelf-label kicker">Finished</p>
            <ul class="book-list">
              {finished.map((book) => (
                <li class="book">
                  <p class="book-status kicker">{bookStatusLabels[book.data.status]}</p>
                  <p class="book-title">{book.data.title}</p>
                  <p class="book-author">{book.data.author}</p>
                </li>
              ))}
            </ul>
          </div>
        )}
      </>
    ) : (
      <div class="desk-note">
        <p class="kicker kicker-red">A shelf in progress</p>
        <EmptyState message="No books recorded here yet." />
        <p class="desk-note-copy">No ratings. No fixed subject. Just a record of curiosity.</p>
      </div>
    )
  }
  <a class="desk-link kicker" href="/read/">Visit the reading desk <span aria-hidden="true">↗</span></a>
</section>

<style>
  .desk {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    min-height: 32.5rem;
    padding: 1.75rem;
    background: var(--red);
    color: var(--surface);
  }

  .desk-kicker {
    margin: 0;
    color: var(--ink-on-red);
  }

  .desk-title {
    margin: 0;
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    line-height: 0.95;
    letter-spacing: -0.044em;
  }

  .book-author {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--muted);
  }

  .book-status {
    margin: 0;
  }

  .shelf {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.125rem;
    background: var(--surface);
    color: var(--ink);
  }


  .book-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .book-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.15;
  }
  .book-status {
    margin: 0;
    color: var(--red-text);
  }

  .shelf-label {
    margin: 0;
    font-weight: 500;
    text-transform: uppercase;
  }

  .shelf-label.kicker-red,
  .shelf-label.kicker {
    color: var(--red-text);
  }

  .desk-note {
    padding: 1.25rem;
    background: var(--surface);
    color: var(--ink);
    rotate: -1deg;
  }

  .desk-note-copy {
    margin: 1rem 0 0;
    font-family: var(--font-serif);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .desk-link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.75rem;
    min-height: 2.75rem;
    margin-block-start: auto;
    color: var(--ink-on-red);
    text-underline-offset: 0.35em;
  }

  .desk-link span {
    transition: transform 180ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .desk-link:hover span {
      transform: translate(2px, -2px);
    }
  }

  @media (max-width: 47.9375rem) {
    .desk {
      min-height: 16.25rem;
      padding: 1.125rem;
    }

    .desk-title {
      font-size: 2rem;
    }
  }
</style>
