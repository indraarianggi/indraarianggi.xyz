---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { workStatusLabels } from '../lib/content';

type Props = {
  entry: CollectionEntry<'work'>;
  index: number;
};

const { entry, index } = Astro.props;

const number = String(index + 1).padStart(2, '0');
---

<div class="stage" data-project-panel>
  {entry.data.image && (
    <Image
      class="stage-image"
      src={entry.data.image}
      alt={entry.data.imageAlt ?? ''}
      widths={[720, 1080]}
      sizes="(min-width: 90rem) 44rem, 50vw"
      loading="lazy"
    />
  )}
  <p class="stage-tag kicker">{`ACTIVE / ${number}`}</p>
  <div class="stage-caption">
    <p class="stage-summary">{entry.data.summary}</p>
    <p class="stage-foot mono-meta">{entry.data.role} / {workStatusLabels[entry.data.status]}</p>
  </div>
</div>

<style>
  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    height: 100%;
    gap: 2rem;
    overflow: hidden;
    background: var(--ink);
    color: var(--surface);
    padding: 1.75rem;
  }

  .stage :global(.stage-image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    outline: none;
  }

  .stage-tag {
    position: relative;
    margin: 0;
    padding: 0.5rem 0.625rem;
    background: var(--ink);
    color: var(--red-on-ink);
  }

  .stage-caption {
    position: relative;
    max-width: 34rem;
    padding: 1.25rem;
    background: var(--ink);
  }

  .stage-summary {
    margin: 0 0 1rem;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 1.94vw, 1.75rem);
    line-height: 1.2;
    text-wrap: pretty;
  }

  .stage-foot {
    margin: 0;
    line-height: 1.5;
    color: var(--red-on-ink);
  }
</style>
