---
/*
  Metadata as a film slate. The striped stick snaps shut once on arrival:
  a single beat that says "take one, action" before the reading starts.
*/
type Props = {
  heading: string;
  rows: Array<{ label: string; value: string }>;
  links?: Array<{ href: string; label: string }>;
};

const { heading, rows, links = [] } = Astro.props;
---

<aside class="clapper" aria-label={heading}>
  <div class="sticks" aria-hidden="true">
    <span class="stick stick-top"></span>
    <span class="stick"></span>
  </div>
  <div class="board">
    <p class="board-heading label dim">{heading}</p>
    <dl class="board-rows">
      {
        rows.map((row) => (
          <div class="board-row">
            <dt class="label dim">{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))
      }
    </dl>
    {
      links.length > 0 && (
        <p class="board-links">
          {links.map((link) => (
            <a class="board-link label" href={link.href}>{link.label}</a>
          ))}
        </p>
      )
    }
  </div>
</aside>

<style>
  .clapper {
    display: grid;
    align-self: end;
    min-width: 0;
  }

  .sticks {
    display: grid;
    gap: 2px;
    margin-bottom: 2px;
  }

  .stick {
    height: 1.375rem;
    background: repeating-linear-gradient(-55deg, var(--chalk) 0 1.1rem, var(--stage-raise) 1.1rem 2.2rem);
  }

  .stick-top {
    transform-origin: 0 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .stick-top {
      animation: clap 620ms 650ms both;
    }
  }

  /* Swing in under gravity, strike, a small rebound, settle. */
  @keyframes clap {
    0% {
      rotate: -24deg;
      animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45);
    }
    62% {
      rotate: 0deg;
      animation-timing-function: var(--ease-out);
    }
    78% {
      rotate: -3deg;
      animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45);
    }
    100% {
      rotate: 0deg;
    }
  }

  .board {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--stage-raise);
    border: 1px solid var(--line);
  }

  .board-heading {
    margin: 0;
  }

  .board-rows {
    display: grid;
    margin: 0;
  }

  .board-row {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.5rem;
    border-top: 1px solid var(--line);
  }

  .board-row dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .board-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }

  .board-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    background: var(--chalk);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--dur-quick) ease, transform 160ms var(--ease-out);
  }

  .board-link:active {
    transform: scale(0.96);
  }

  @media (hover: hover) and (pointer: fine) {
    .board-link:hover {
      background: var(--signal);
    }
  }
</style>
