---
// Cloudflare Web Analytics: cookieless, so no consent banner. The token is
// public by design (it ships in every page), but it lives in the environment so
// local builds and forks never report into the production dashboard.
const token = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN;
const enabled = import.meta.env.PROD && Boolean(token);
---

{
  enabled && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token })}
    />
  )
}
