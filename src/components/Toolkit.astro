---
import { Icon } from 'astro-icon/components';
import { toolGroups, toolkit } from '../config/site';
---

<section class="toolkit" aria-labelledby="toolkit-title">
  <h2 class="section-label" id="toolkit-title">Toolkit</h2>
  {
    toolGroups.map((group) => (
      <div class="group">
        <h3 class="group-label">{group}</h3>
        <ul class="tools">
          {toolkit
            .filter((tool) => tool.group === group)
            .map((tool) => (
              <li class:list={['tool', { learning: tool.learning }]} style={tool.brandHex ? `--brand: #${tool.brandHex}` : undefined}>
                {tool.icon ? (
                  <Icon class="tool-icon" name={`simple-icons:${tool.icon}`} size={24} aria-hidden="true" />
                ) : (
                  <span class="tool-monogram" aria-hidden="true">
                    {tool.monogram}
                  </span>
                )}
                <span class="tool-name">
                  {tool.name}
                  {tool.learning && <span class="sr-only"> (currently learning)</span>}
                </span>
              </li>
            ))}
        </ul>
      </div>
    ))
  }
</section>

<style>
  /* Canvas: 12px between groups, 28px from the label to the first group. */
  .toolkit {
    display: grid;
    gap: 0.75rem;
  }

  .section-label + .group {
    margin-block-start: 1rem;
  }

  .group {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .group-label {
    align-self: center;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tool {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.5625rem;
    width: 4.25rem;
    height: 4.75rem;
    padding-block-start: 1.0625rem;
    border-radius: 10px;
  }

  .tool-icon,
  .tool-monogram {
    color: var(--ink);
    transition: color 200ms var(--ease-out);
  }

  .tool-monogram {
    height: 24px;
    font-family: var(--font-serif);
    font-size: 1.375rem;
    line-height: 24px;
  }

  .tool-name {
    color: var(--muted);
    font-size: 0.625rem;
    text-align: center;
    transition: color 200ms var(--ease-out);
  }

  .learning {
    outline: 1px solid var(--accent);
    outline-offset: -1px;
  }

  .learning .tool-name {
    color: var(--accent);
  }

  @media (hover: hover) {
    .tool:hover :is(.tool-icon, .tool-monogram) {
      color: var(--brand, var(--ink));
    }

    .tool:hover .tool-name {
      color: var(--ink);
    }
  }

  .tool:active :is(.tool-icon, .tool-monogram) {
    color: var(--brand, var(--ink));
  }

  /* Mobile canvas: 62x64 tiles in five columns, a 22px icon, 9px names. */
  @media (max-width: 47.9375rem) {
    .toolkit {
      gap: 1.25rem;
    }

    .section-label + .group {
      margin-block-start: 0;
    }

    .group {
      grid-template-columns: 1fr;
      gap: 0.625rem;
    }

    .group-label {
      align-self: start;
    }

    .tools {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.625rem;
    }

    .tool {
      align-content: center;
      gap: 0.5rem;
      width: auto;
      height: 4rem;
      padding-block-start: 0;
    }

    .tool-icon {
      width: 22px;
      height: 22px;
    }

    .tool-name {
      font-size: 0.5625rem;
    }
  }
</style>
