---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate } from '../lib/content';

/* The newest note, given the big frame. Lives on paper. */
type Props = {
  entry: CollectionEntry<'blog'>;
};

const { entry } = Astro.props;
const href = `/blog/${entry.id}/`;
---

<article class="lead" data-play>
  <a class="lead-frame" href={href} tabindex="-1" aria-hidden="true" data-wipe-label={entry.data.title}>
    {
      entry.data.image ? (
        <Image src={entry.data.image} alt="" widths={[640, 960, 1280]} sizes="(min-width: 64rem) 55vw, 100vw" data-drift />
      ) : (
        <span class="lead-mark display">Latest</span>
      )
    }
  </a>
  <div class="lead-copy">
    <p class="lead-meta label" data-rise>
      <span class="keyframe" aria-hidden="true"></span>
      <span>Latest / {formatDate(entry.data.date)}</span>
      {entry.data.topics[0] && <span class="dim">{entry.data.topics[0]}</span>}
    </p>
    <h2 class="lead-title display" data-rise style="--rd: 1">
      <a href={href} data-wipe-label={entry.data.title}>{entry.data.title}</a>
    </h2>
    <p class="lead-summary serif" data-rise style="--rd: 2">{entry.data.description}</p>
  </div>
</article>

<style>
  .lead {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: end;
  }

  .lead-frame {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: clip;
    background: var(--ink);
  }

  .lead-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    outline: none;
  }

  .lead-mark {
    position: absolute;
    inset: auto auto 1rem 1.25rem;
    color: var(--paper);
    font-size: 5rem;
  }

  .lead-copy {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }

  .lead-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
  }

  .lead-title {
    margin: 0;
    font-size: clamp(2.25rem, 4.6vw, 4.25rem);
    overflow-wrap: anywhere;
  }

  .lead-title a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.1em;
    transition: text-decoration-color var(--dur-quick) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .lead-title a:hover,
    .lead:has(.lead-frame:hover) .lead-title a {
      text-decoration-color: var(--red-text);
    }
  }

  .lead-summary {
    max-width: 40ch;
    margin: 0;
    color: var(--muted);
    font-size: 1.1875rem;
    line-height: 1.45;
  }

  @media (max-width: 63.9375rem) {
    .lead {
      grid-template-columns: 1fr;
    }
  }
</style>
