---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { workStatusLabels } from '../lib/content';

/*
  Featured work as a deck of clips. Each card pins under the masthead and
  the next one slides over it; the covered card recedes, scrubbed by the
  next card's own entry into view (a named view timeline per card).
  Pinning only happens where a whole card fits on screen.
*/
type Props = {
  entries: CollectionEntry<'work'>[];
};

const { entries } = Astro.props;
const names = entries.map((_, i) => `--clip-${i}`);
---

<ol class="deck" style={`timeline-scope: ${names.join(', ')}`}>
  {
    entries.map((entry, i) => {
      const number = String(i + 1).padStart(2, '0');
      const year = entry.data.date.getUTCFullYear();
      const nextTimeline = names[i + 1];
      return (
        <li class="deck-item" style={`--i: ${i}; view-timeline-name: ${names[i]}`}>
          <a
            class:list={['deck-card paper', { 'deck-card-recedes': nextTimeline }]}
            href={`/work/${entry.id}/`}
            data-wipe-label={entry.data.title}
            style={nextTimeline ? `--next: ${nextTimeline}` : undefined}
          >
            <div class="deck-copy">
              <p class="deck-tag label">
                <span>Clip {number}</span>
                <span class="keyframe" aria-hidden="true" />
                <span>{workStatusLabels[entry.data.status]}</span>
              </p>
              <h3 class="deck-title display">{entry.data.title}</h3>
              <p class="deck-summary serif">{entry.data.summary}</p>
              <dl class="deck-meta label">
                <div>
                  <dt class="dim">Role</dt>
                  <dd>{entry.data.role}</dd>
                </div>
                <div>
                  <dt class="dim">Year</dt>
                  <dd>{year}</dd>
                </div>
                {entry.data.stack.length > 0 && (
                  <div>
                    <dt class="dim">Stack</dt>
                    <dd>{entry.data.stack.join(', ')}</dd>
                  </div>
                )}
              </dl>
              <p class="deck-open label">Open case study</p>
            </div>
            <div class="deck-media">
              {entry.data.image ? (
                <Image
                  src={entry.data.image}
                  alt={entry.data.imageAlt ?? ''}
                  widths={[560, 900, 1200]}
                  sizes="(min-width: 64rem) 46vw, 100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              ) : (
                <span class="deck-number display" aria-hidden="true">{number}</span>
              )}
            </div>
          </a>
        </li>
      );
    })
  }
</ol>

<style>
  .deck {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .deck-card {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    min-height: min(38rem, calc(100svh - 9rem));
    overflow: clip;
    text-decoration: none;
    transform-origin: 50% 0;
  }

  .deck-copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.25rem, 2.5vw, 2.25rem);
    min-width: 0;
  }

  .deck-tag {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    color: var(--muted);
  }

  .deck-title {
    margin: auto 0 0;
    font-size: clamp(2.25rem, 4.6vw, 4.5rem);
    overflow-wrap: anywhere;
  }

  .deck-summary {
    max-width: 36ch;
    margin: 0;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.4;
  }

  .deck-meta {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding-block-start: 1rem;
    border-top: 1px solid var(--ink);
  }

  .deck-meta div {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
  }

  .deck-meta dd {
    margin: 0;
  }

  .deck-open {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.625rem 0.875rem;
    background: var(--ink);
    color: var(--paper);
    transition: transform 160ms var(--ease-out);
  }

  .deck-card:active .deck-open {
    transform: scale(0.96);
  }

  .deck-media {
    position: relative;
    min-height: 18rem;
    overflow: clip;
    background: var(--ink);
  }

  .deck-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    outline: none;
    transition: scale 700ms var(--ease-out);
  }

  .deck-number {
    position: absolute;
    inset: auto auto 1rem 1.5rem;
    color: var(--paper);
    font-size: 10rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .deck-card:hover .deck-media :global(img) {
      scale: 1.04;
    }
  }

  .deck-card:focus-visible {
    outline-offset: 4px;
  }

  /* Pin and stack only when a whole card fits. */
  @media (min-width: 48rem) and (min-height: 40rem) {
    .deck {
      gap: 12svh;
      padding-block-end: 4svh;
    }

    .deck-item {
      position: sticky;
      top: calc(1.5rem + var(--i) * 0.875rem);
    }
  }

  @supports (animation-timeline: view()) {
    @media (min-width: 48rem) and (min-height: 40rem) and (prefers-reduced-motion: no-preference) {
      .deck-card-recedes {
        animation: recede linear both;
        animation-timeline: var(--next);
        animation-range: entry 0% entry 100%;
      }
    }
  }

  @keyframes recede {
    to {
      transform: scale(0.92);
      filter: brightness(0.55);
    }
  }

  @media (max-width: 47.9375rem) {
    .deck-card {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .deck-media {
      order: -1;
      aspect-ratio: 4 / 3;
      min-height: 0;
    }
  }
</style>
