---
import type { TocItem } from '../lib/toc';

type Props = {
  tree: TocItem[];
  /** `rail`: desktop right gutter. `sheet`: the Contents bottom sheet, with larger targets. */
  variant: 'rail' | 'sheet';
};

const { tree, variant } = Astro.props;
---

<ol class:list={['toc-list', `toc-${variant}`]}>
  {
    tree.map((item) => (
      <li>
        <a class="toc-link" href={`#${item.slug}`} data-toc-link>
          {item.text}
        </a>
        {item.children.length > 0 && (
          <ol>
            {item.children.map((child) => (
              <li>
                <a class="toc-link" href={`#${child.slug}`} data-toc-link>
                  {child.text}
                </a>
              </li>
            ))}
          </ol>
        )}
      </li>
    ))
  }
</ol>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const idOf = (link: HTMLAnchorElement) => decodeURIComponent(link.hash.slice(1));
  const headings = [...new Set(links.map(idOf))].flatMap((id) => document.getElementById(id) ?? []);

  const mark = (id: string) => {
    for (const link of links) {
      if (idOf(link) === id) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  };

  // A heading becomes current once it reaches the top quarter of the screen.
  const observer = new IntersectionObserver(
    (entries) => {
      const top = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (top) mark(top.target.id);
    },
    { rootMargin: '0px 0px -75% 0px' },
  );
  headings.forEach((heading) => observer.observe(heading));
</script>

<style>
  .toc-list,
  .toc-list ol {
    display: grid;
    gap: 0.4375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-list ol {
    margin-block-start: 0.4375rem;
    padding-inline-start: 0.75rem;
  }

  .toc-link {
    display: block;
    color: var(--ink);
    font-size: 0.8125rem;
    line-height: 1.3;
    text-decoration: none;
  }

  .toc-list ol .toc-link {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .toc-list .toc-link[aria-current='location'] {
    color: var(--accent);
    font-weight: 500;
  }

  @media (hover: hover) {
    .toc-link:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  /* Rail: 24px hit areas (WCAG target size) that do not overlap, laid out near the canvas's 24px pitch. */
  .toc-rail,
  .toc-rail ol {
    gap: 0.5rem;
  }

  .toc-rail .toc-link {
    padding-block: 0.25rem;
    margin-block: -0.25rem;
  }

  .toc-rail ol {
    gap: 0.625rem;
    margin-block-start: 0.75rem;
  }

  .toc-rail ol .toc-link {
    padding-block: 0.3125rem;
    margin-block: -0.3125rem;
  }

  /* Sheet: 44px targets, H3s indented, a deep-orange marker on the current section. */
  .toc-sheet,
  .toc-sheet ol {
    gap: 0.125rem;
  }

  .toc-sheet ol {
    margin: 0;
    padding-inline-start: 1rem;
  }

  .toc-sheet .toc-link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
  }

  .toc-sheet ol .toc-link {
    font-size: 0.875rem;
  }

  .toc-sheet .toc-link[aria-current='location'] {
    padding-inline-start: 0.75rem;
    font-weight: 400;
  }

  .toc-sheet .toc-link[aria-current='location']::before {
    content: '';
    position: absolute;
    left: 0;
    width: 2px;
    height: 1rem;
    background: var(--accent);
  }
</style>
