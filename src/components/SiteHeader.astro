---
import { site } from '../config/site';

const { pathname } = Astro.url;

const normalize = (href: string) => (href === '/' ? '/' : href.replace(/\/$/, ''));
const currentPath = normalize(pathname);
const navItems = site.primaryNav.filter((item) => item.href !== '/');
---

<header class="masthead shell">
  <a class="brand" href="/" aria-current={currentPath === '/' ? 'page' : undefined}>
    <span class="keyframe brand-key" aria-hidden="true"></span>
    <span class="brand-name">{site.name}</span>
  </a>
  <nav aria-label="Primary">
    <ul class="nav-list">
      {
        navItems.map((item) => {
          const path = normalize(item.href);
          const active = currentPath.startsWith(path);
          return (
            <li>
              <a
                class:list={['nav-link', { 'is-active': active }]}
                href={item.href}
                aria-current={active ? 'page' : undefined}
              >
                <span class="roll"><span class="roll-in" data-text={item.label}>{item.label}</span></span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<style>
  .masthead {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
    padding-block-start: env(safe-area-inset-top);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    color: var(--chalk);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 112%;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  /* The keyframe turns a quarter on hover: the mark responds, the name stays put. */
  .brand-key {
    transition: rotate var(--dur-std) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover .brand-key {
      rotate: 135deg;
    }
  }

  .nav-list {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    color: var(--chalk);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .nav-link.is-active::before {
    content: '';
    width: 0.4375rem;
    height: 0.4375rem;
    rotate: 45deg;
    background: var(--signal);
  }

  /* Label roll: the word slides up out of its mask and a signal-red twin
     follows from below. The mask stays still; only the inner span moves. */
  .roll {
    display: inline-block;
    overflow: clip;
    line-height: 1.3;
  }

  .roll-in {
    position: relative;
    display: block;
  }

  .roll-in::after {
    content: attr(data-text);
    /* Empty alt text: screen readers announce the label once, not twice. */
    content: attr(data-text) / '';
    position: absolute;
    inset: 100% 0 auto;
    color: var(--signal);
  }

  @media (hover: hover) and (pointer: fine) {
    .roll-in {
      transition: transform 320ms var(--ease-out);
    }

    .nav-link:hover .roll-in {
      transform: translateY(-100%);
    }
  }

  .nav-link:active .roll {
    opacity: 0.7;
  }

  @media (max-width: 47.9375rem) {
    .masthead {
      min-height: 3.75rem;
      padding-block-start: max(0.25rem, env(safe-area-inset-top));
    }

    .brand {
      font-size: 0.8125rem;
    }

    .nav-link {
      padding-inline: 0.625rem;
    }
  }
</style>
