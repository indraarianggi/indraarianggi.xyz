---
import { site } from '../config/site';

const { pathname } = Astro.url;

const normalize = (href: string) => (href === '/' ? '/' : href.replace(/\/$/, ''));
const currentPath = normalize(pathname);
---

<header class:list={['masthead shell', { 'masthead-home': currentPath === '/' }]}>
  <div class="masthead-inner">
    <a
      class="brand"
      href="/"
      aria-current={currentPath === '/' ? 'page' : undefined}
    >
      <span class="brand-full">Indra Arianggi</span>
      <span class="brand-short" aria-hidden="true">IA</span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav-list">
        {
          site.primaryNav.map((item) => {
            const path = normalize(item.href);
            const active = path === '/' ? currentPath === '/' : currentPath.startsWith(path);
            return (
              <li>
                <a
                  class:list={['nav-link', { 'nav-link-active': active }]}
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .masthead {
    padding-block-start: max(1.875rem, env(safe-area-inset-top));
  }

  .masthead-inner {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
    border-block-start: 3px solid var(--ink);
    border-block-end: 1px solid var(--ink);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    padding-block: 0.625rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-poster);
    font-size: 1.125rem;
    letter-spacing: -0.028em;
    text-transform: uppercase;
  }

  .brand-short {
    display: none;
    font-size: 1.25rem;
  }

  .masthead-home .brand {
    display: none;
  }

  .masthead-home .masthead-inner {
    justify-content: flex-end;
  }

  nav,
  .nav-list,
  .nav-list li {
    display: flex;
    align-items: stretch;
  }

  .nav-list {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 1rem 1.375rem;
    color: var(--ink);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.6875rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    inset: auto 1.375rem 1rem;
    height: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms var(--ease-out);
  }

  .nav-link-active {
    background: var(--red);
    color: var(--ink-on-red);
  }


  @media (hover: hover) and (pointer: fine) {
    .nav-link:not(.nav-link-active):hover::after {
      transform: scaleX(1);
    }
  }

  .nav-link:active {
    background: var(--red-soft);
    color: var(--ink);
  }
  @media (max-width: 47.9375rem) {
    .masthead {
      padding-block-start: max(1rem, env(safe-area-inset-top));
    }

    .masthead-home .brand {
      display: inline-flex;
    }

    .masthead-home .masthead-inner {
      justify-content: space-between;
    }
    .masthead-inner {
      min-height: 3.875rem;
      gap: 1rem;
    }

    .brand {
      padding-block: 0;
    }

    /* Keep the full name in the accessibility tree while showing the
       compact IA mark visually. */
    .brand-full {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .brand-short {
      display: inline;
    }

    .nav-link {
      padding: 1rem 0.625rem;
      font-size: 0.625rem;
      letter-spacing: 0.05em;
    }

    .nav-link-active {
      background: transparent;
      color: var(--red-text);
    }

    .nav-link::after {
      inset-inline: 0.625rem;
      bottom: 0.75rem;
    }
  }
</style>
