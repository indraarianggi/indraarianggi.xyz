---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';

/* One book on a shelf. Lives on paper. The spine colour marks the shelf:
   signal for what is being read now, ink for everything else. */
type Props = {
  book: CollectionEntry<'books'>;
  shelf: 'red' | 'black';
  statusLabel: string;
};

const { book, shelf, statusLabel } = Astro.props;
const { Content } = book.body ? await render(book) : { Content: null };
---

<li class="book" data-rise>
  <span class:list={['spine', `spine-${shelf}`]} aria-hidden="true"></span>
  <div class="book-main">
    {
      book.data.cover && book.data.coverAlt && (
        <Image
          class="book-cover"
          src={book.data.cover}
          alt={book.data.coverAlt}
          widths={[120, 240]}
          sizes="120px"
          loading="lazy"
        />
      )
    }
    <div class="book-copy">
      <p class="book-status label">{statusLabel}</p>
      <p class="book-title">{book.data.title}</p>
      <p class="book-author">{book.data.author}</p>
    </div>
    {Content && <div class="prose book-note"><Content /></div>}
  </div>
</li>

<style>
  .book {
    display: grid;
    grid-template-columns: 0.5rem minmax(0, 1fr);
    background: var(--surface);
    border: 1px solid var(--rule);
  }

  .spine-red {
    background: var(--signal);
  }

  .spine-black {
    background: var(--ink);
  }

  .book-main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem 1.25rem;
    padding: 1.25rem;
  }

  .book-main :global(.book-cover) {
    width: 5rem;
    height: auto;
  }

  .book-copy p {
    margin: 0;
  }

  .book-status {
    color: var(--red-text);
    margin-bottom: 0.5rem !important;
  }

  .book-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 106%;
    font-size: 1.25rem;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .book-author {
    font-family: var(--font-serif);
    color: var(--muted);
  }

  .book-note {
    grid-column: 1 / -1;
    font-size: 1rem;
  }
</style>
