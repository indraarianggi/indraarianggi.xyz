---
/* Honest empty state: says what is missing. */
type Props = {
  message: string;
};

const { message } = Astro.props;
---

<p class="empty-state">{message}</p>

<style>
  .empty-state {
    padding-block: 1.25rem;
    border-block: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
