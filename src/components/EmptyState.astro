---
type Props = {
  message: string;
  tone?: 'default' | 'inverse';
};

const { message, tone = 'default' } = Astro.props;
---

<div class:list={['empty-state', { 'empty-state-inverse': tone === 'inverse' }]}>
  <p class="empty-message">{message}</p>
</div>

<style>
  .empty-state {
    border-top: 1px solid var(--rule);
    padding-block: 1.75rem;
  }

  .empty-state-inverse {
    border-top-color: var(--muted);
  }

  .empty-state-inverse .empty-message {
    color: var(--surface);
  }

  .empty-message {
    max-width: 44ch;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--muted);
  }
</style>
