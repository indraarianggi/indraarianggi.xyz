---
import { getCollection } from 'astro:content';
import { groupBooks, visibleNewestFirst } from '../lib/content';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import BookEntry from '../components/BookEntry.astro';

const production = import.meta.env.PROD;
const books = visibleNewestFirst(await getCollection('books'), production);
const groups = groupBooks(books);

const shelfLabels = {
  reading: 'Reading now',
  finished: 'Finished',
  paused: 'Paused / Want to read',
  'want-to-read': 'Paused / Want to read',
} as const;

const shelfSpines = {
  reading: 'red',
  finished: 'black',
  paused: 'black',
  'want-to-read': 'black',
} as const;

const statusLabels = {
  reading: 'Reading now',
  finished: 'Finished',
  paused: 'Paused',
  'want-to-read': 'Want to read',
} as const;

// Paused and Want to read share one visual shelf; merge their groups and
// keep the individual status label on every entry.
const shelves: Array<{ number: string; label: string; spine: 'red' | 'black'; entries: typeof groups[number]['entries'] }> = [];
let sharedShelf: (typeof shelves)[number] | undefined;

for (const group of groups) {
  if (group.status === 'paused' || group.status === 'want-to-read') {
    if (!sharedShelf) {
      sharedShelf = {
        number: String(shelves.length + 1).padStart(2, '0'),
        label: shelfLabels[group.status],
        spine: shelfSpines[group.status],
        entries: [...group.entries],
      };
      shelves.push(sharedShelf);
    } else {
      sharedShelf.entries.push(...group.entries);
    }
    continue;
  }
  shelves.push({
    number: String(shelves.length + 1).padStart(2, '0'),
    label: shelfLabels[group.status],
    spine: shelfSpines[group.status],
    entries: group.entries,
  });
}
---

<BaseLayout title={`Read | ${site.name}`} path="/read/">
  <div class="shell">
    <section class="header" aria-labelledby="read-title">
      <h1 class="giant poster" id="read-title">Read / Curiosity</h1>
      <div class="context">
        <p class="kicker">Curiosity shelf / open</p>
        <p class="serif-lede">A record of books that hold my interest, wherever they came from.</p>
      </div>
    </section>

    <section class="shelves" aria-label="Book shelves">
      {
        shelves.length === 0 && (
          <EmptyState message="No books recorded here yet." />
        )
      }
      {
        shelves.map((shelf) => (
          <section class="shelf" aria-label={shelf.label}>
            <div class:list={['shelf-block', `shelf-${shelf.spine}`]}>
              <p class="shelf-number poster">{shelf.number}</p>
              <p class="shelf-label kicker">{shelf.label}</p>
            </div>
            <ul class="shelf-books">
              {shelf.entries.map((book) => (
                <BookEntry book={book} shelf={shelf.spine} statusLabel={statusLabels[book.data.status]} />
              ))}
            </ul>
          </section>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    gap: 0.5rem;
    margin-block-start: 1.25rem;
  }

  .giant {
    margin: 0;
    font-size: clamp(3.25rem, 7.4vw, 6.625rem);
    line-height: 0.83;
    letter-spacing: -0.047em;
  }

  .context {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--red);
    color: var(--ink-on-red);
  }

  .context p {
    margin: 0;
  }

  .context .kicker {
    color: var(--ink-on-red);
  }

  .shelves {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-block: 2rem 3.5rem;
  }

  .shelf {
    display: grid;
    grid-template-columns: minmax(0, 16.25rem) minmax(0, 1fr);
    gap: 0.5rem;
    align-items: stretch;
  }

  .shelf-block {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4rem;
    padding: 1.25rem;
  }

  .shelf-red {
    background: var(--red);
    color: var(--ink-on-red);
  }

  .shelf-red .shelf-label {
    color: var(--ink-on-red);
  }

  .shelf-red .poster-mark,
  .shelf-red .poster {
    color: var(--surface);
  }

  .shelf-black {
    background: var(--ink);
    color: var(--surface);
  }

  .shelf-block p {
    margin: 0;
  }

  .shelf-label {
    color: var(--surface);
  }

  .shelf-books {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(24rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 47.9375rem) {
    .header {
      grid-template-columns: 1fr;
      margin-block-start: 1rem;
    }

    .shelves {
      margin-block: 1.5rem 2.5rem;
    }

    .shelf {
      grid-template-columns: 1fr;
    }

    .shelf-block {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.875rem 1.25rem;
    }

    .shelf-books {
      grid-template-columns: 1fr;
    }
  }
</style>
