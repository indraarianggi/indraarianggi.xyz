---
import { getCollection } from 'astro:content';
import { groupBooks, visibleNewestFirst } from '../lib/content';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import BookEntry from '../components/BookEntry.astro';
import KineticText from '../components/KineticText.astro';

const production = import.meta.env.PROD;
const books = visibleNewestFirst(await getCollection('books'), production);
const groups = groupBooks(books);

const shelfLabels = {
  reading: 'Reading now',
  finished: 'Finished',
  paused: 'Paused / Want to read',
  'want-to-read': 'Paused / Want to read',
} as const;

const shelfSpines = {
  reading: 'red',
  finished: 'black',
  paused: 'black',
  'want-to-read': 'black',
} as const;

const statusLabels = {
  reading: 'Reading now',
  finished: 'Finished',
  paused: 'Paused',
  'want-to-read': 'Want to read',
} as const;

// Paused and Want to read share one visual shelf; merge their groups and
// keep the individual status label on every entry.
const shelves: Array<{ number: string; label: string; spine: 'red' | 'black'; entries: typeof groups[number]['entries'] }> = [];
let sharedShelf: (typeof shelves)[number] | undefined;

for (const group of groups) {
  if (group.status === 'paused' || group.status === 'want-to-read') {
    if (!sharedShelf) {
      sharedShelf = {
        number: String(shelves.length + 1).padStart(2, '0'),
        label: shelfLabels[group.status],
        spine: shelfSpines[group.status],
        entries: [...group.entries],
      };
      shelves.push(sharedShelf);
    } else {
      sharedShelf.entries.push(...group.entries);
    }
    continue;
  }
  shelves.push({
    number: String(shelves.length + 1).padStart(2, '0'),
    label: shelfLabels[group.status],
    spine: shelfSpines[group.status],
    entries: group.entries,
  });
}
---

<BaseLayout title={`Read | ${site.name}`} path="/read/">
  <section class="title-card shell" data-scene="Title" aria-labelledby="read-title">
    <p class="card-line label dim">
      <span>Curiosity shelf / open</span>
      <span class="keyframe" aria-hidden="true"></span>
      <span>{String(books.length).padStart(2, '0')} books</span>
    </p>
    <KineticText as="h1" id="read-title" split="chars" text="Read." delay={80} class="card-title display" />
    <p class="card-lede serif">A record of books that hold my interest, wherever they came from.</p>
  </section>

  <section class="shelves paper" data-scene="Shelves" data-frame aria-label="Book shelves">
    <div class="shell">
      {
        shelves.length === 0 && (
          <EmptyState message="No books recorded here yet. The shelf fills as I finish them." />
        )
      }
      {
        shelves.map((shelf) => (
          <section class="shelf" aria-label={shelf.label} data-play>
            <p class="shelf-head" data-rise>
              <span class="shelf-number display">{shelf.number}</span>
              <span class="shelf-label label">{shelf.label}</span>
            </p>
            <ul class="shelf-books">
              {shelf.entries.map((book) => (
                <BookEntry book={book} shelf={shelf.spine} statusLabel={statusLabels[book.data.status]} />
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .title-card {
    display: grid;
    gap: 1.5rem;
    padding-block: 2rem clamp(3rem, 8vw, 6rem);
    container-type: inline-size;
  }

  .card-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
  }

  .title-card :global(.card-title) {
    margin: 0;
    font-size: 27cqi;
    line-height: 0.8;
    letter-spacing: -0.05em;
  }

  .card-lede {
    max-width: 30ch;
    margin: 0;
    justify-self: end;
    font-size: clamp(1.25rem, 2.2vw, 1.875rem);
    line-height: 1.25;
  }

  .shelves {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .shelf + .shelf {
    margin-block-start: 3rem;
  }

  .shelf-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin: 0 0 1.25rem;
    padding-block-start: 1rem;
    border-top: 1px solid var(--ink);
  }

  .shelf-number {
    font-size: 2.5rem;
  }

  .shelf-books {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 47.9375rem) {
    .card-lede {
      justify-self: start;
    }
  }
</style>
