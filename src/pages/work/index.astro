---
import { getCollection } from 'astro:content';
import { visibleNewestFirst } from '../../lib/content';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import ProjectIndex from '../../components/ProjectIndex.astro';

const production = import.meta.env.PROD;
const work = visibleNewestFirst(await getCollection('work'), production);
---

<BaseLayout title={`Work | ${site.name}`} path="/work/">
  <div class="shell">
    <section class="header" aria-labelledby="work-title" data-reveal>
      <h1 class="giant poster" id="work-title">Work<br />Index</h1>
      <div class="context">
        <p class="kicker">Index / {new Date().getUTCFullYear()}</p>
        <p class="serif-lede">Projects I am building and the questions they leave behind.</p>
      </div>
    </section>

    <section class="catalogue" aria-label="Project index" data-reveal>
      {
        work.length > 0 ? (
          <ProjectIndex entries={work} />
        ) : (
          <EmptyState message="Nothing published here yet. I'm still building." />
        )
      }
    </section>

    <section class="statement" aria-label="Statement" data-reveal>
      <p class="poster">The index changes as the work does.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .header {
    display: grid;
    grid-template-columns: minmax(0, 980fr) minmax(0, 348fr);
    min-height: 18.125rem;
    border-bottom: 3px solid var(--ink);
  }

  .giant {
    margin: 0;
    padding-block: 1.75rem;
    font-size: clamp(4.125rem, 7.36vw, 6.625rem);
    line-height: 0.83;
    letter-spacing: -0.047em;
  }

  .context {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem;
    background: var(--red);
  }

  .context p {
    margin: 0;
  }

  .context .kicker {
    color: var(--ink-on-red);
  }

  .context .serif-lede {
    color: var(--surface);
    font-size: 1.5rem;
  }

  .statement {
    display: flex;
    align-items: center;
    min-height: 16.875rem;
    padding-block: 3rem;
  }

  .statement p {
    max-width: 51rem;
    margin: 0;
    font-size: clamp(2.5rem, 3.34vw, 3rem);
    line-height: 0.95;
    letter-spacing: -0.042em;
  }

  @media (max-width: 47.9375rem) {
    .header {
      display: block;
      border-bottom: 0;
      padding-block: 1.5rem;
    }

    .giant {
      padding: 0;
      font-size: 4.125rem;
    }

    .context {
      padding: 1.5rem 0 0;
      background: transparent;
    }

    .context .kicker {
      display: none;
    }

    .context .serif-lede {
      color: var(--muted);
      font-size: 1.125rem;
      line-height: 1.35;
    }

    .statement {
      min-height: 0;
      padding-block: 2rem;
    }
  }
</style>
