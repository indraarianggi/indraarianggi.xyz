---
import { getCollection } from 'astro:content';
import { visibleNewestFirst } from '../../lib/content';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import KineticText from '../../components/KineticText.astro';
import WorkReel from '../../components/WorkReel.astro';

const production = import.meta.env.PROD;
const work = visibleNewestFirst(await getCollection('work'), production);
const count = String(work.length).padStart(2, '0');
---

<BaseLayout title={`Work | ${site.name}`} path="/work/">
  <div class="shell">
    <section class="title-card" data-scene="Title" aria-labelledby="work-title">
      <p class="card-line label dim">
        <span>Index / {new Date().getUTCFullYear()}</span>
        <span class="keyframe" aria-hidden="true"></span>
        <span>{count} clips</span>
      </p>
      <KineticText as="h1" id="work-title" split="chars" text="Work" delay={80} class="card-title display" />
      <p class="card-lede serif">Projects I am building and the questions they leave behind.</p>
    </section>

    <section class="catalogue" data-scene="Reel" aria-label="Project index">
      {
        work.length > 0 ? (
          <WorkReel entries={work} />
        ) : (
          <EmptyState message="Nothing published here yet. I'm still building." />
        )
      }
    </section>

    <section class="statement" data-scene="Out" aria-label="Statement">
      <KineticText
        as="p"
        split="words"
        play="view"
        text="The index changes as the work does."
        class="statement-text display"
      />
    </section>
  </div>
</BaseLayout>

<style>
  .title-card {
    display: grid;
    gap: 1.5rem;
    padding-block: 2rem clamp(3rem, 8vw, 6rem);
    container-type: inline-size;
  }

  .card-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
  }

  .title-card :global(.card-title) {
    margin: 0;
    font-size: 27cqi;
    line-height: 0.8;
    letter-spacing: -0.05em;
  }

  .card-lede {
    max-width: 28ch;
    margin: 0;
    justify-self: end;
    font-size: clamp(1.25rem, 2.2vw, 1.875rem);
    line-height: 1.25;
  }

  .statement {
    padding-block: clamp(4rem, 14svh, 9rem);
  }

  .statement :global(.statement-text) {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 5.5rem);
  }

  @media (max-width: 47.9375rem) {
    .card-lede {
      justify-self: start;
    }
  }
</style>
