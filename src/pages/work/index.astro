---
import { getCollection } from 'astro:content';
import { visibleNewestFirst } from '../../lib/content';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import ProjectIndexRow from '../../components/ProjectIndexRow.astro';
import ProjectFeature from '../../components/ProjectFeature.astro';

const production = import.meta.env.PROD;
const work = visibleNewestFirst(await getCollection('work'), production);
---

<BaseLayout title={`Work | ${site.name}`} path="/work/">
  <div class="shell">
    <section class="header" aria-labelledby="work-title">
      <h1 class="giant poster" id="work-title">Work index</h1>
      <div class="context">
        <p class="kicker">Current index / {new Date().getUTCFullYear()}</p>
        <p class="serif-lede">I learn by making things.</p>
      </div>
    </section>

    <section class="catalogue" aria-label="Project index">
      {
        work.length > 0 ? (
          <div class="index-pair">
            <div class="index-list">
              {work.map((entry, index) => (
                <ProjectIndexRow
                  entry={entry}
                  index={index}
                  prompt={index === 0 ? 'Active / view visual' : 'Focus to preview'}
                />
              ))}
            </div>
            <div class="index-stage">
              {work.map((entry, index) => (
                <ProjectFeature entry={entry} index={index} />
              ))}
            </div>
          </div>
        ) : (
          <EmptyState message="Nothing published here yet. I'm still building." />
        )
      }
    </section>

    <section class="statement" aria-label="Statement">
      <p class="poster">The index changes as the work does.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    gap: 0.5rem;
    margin-block-start: 1.25rem;
  }

  .giant {
    margin: 0;
    font-size: clamp(3.25rem, 7.4vw, 6.625rem);
    line-height: 0.83;
    letter-spacing: -0.047em;
  }

  .context {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--red);
    color: var(--surface);
  }

  .context p {
    margin: 0;
  }

  .context .kicker {
    color: var(--surface);
  }

  .catalogue {
    margin-block-start: 2rem;
  }

  .index-pair,
  .index-list,
  .index-stage {
    min-width: 0;
  }

  .index-pair {
    display: grid;
    grid-template-columns: minmax(0, 40.625rem) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .index-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index-stage {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .statement {
    margin-block: 3rem 3.5rem;
  }

  .statement p {
    margin: 0;
    font-size: clamp(2.5rem, 4.4vw, 3rem);
    line-height: 0.95;
    letter-spacing: -0.042em;
  }

  /*
   * Stage switching: pointer hover and keyboard focus on a row reveal its
   * stage panel. The first panel is visible by default; ordinary links
   * remain the primary action, and nothing is hover-only information.
   */
  @media (min-width: 48rem) {
    .index-stage [data-project-panel] {
      display: none;
    }

    .index-stage [data-project-panel]:first-of-type {
      display: block;
    }

    .index-list:has(li:nth-child(1) a:is(:hover, :focus-visible))
      ~ .index-stage
      [data-project-panel]:nth-child(1),
    .index-list:has(li:nth-child(2) a:is(:hover, :focus-visible))
      ~ .index-stage
      [data-project-panel]:nth-child(2),
    .index-list:has(li:nth-child(3) a:is(:hover, :focus-visible))
      ~ .index-stage
      [data-project-panel]:nth-child(3),
    .index-list:has(li:nth-child(4) a:is(:hover, :focus-visible))
      ~ .index-stage
      [data-project-panel]:nth-child(4),
    .index-list:has(li:nth-child(5) a:is(:hover, :focus-visible))
      ~ .index-stage
      [data-project-panel]:nth-child(5),
    .index-list:has(li:nth-child(6) a:is(:hover, :focus-visible))
      ~ .index-stage
      [data-project-panel]:nth-child(6) {
      display: block;
    }
  }

  @media (max-width: 47.9375rem) {
    .header {
      grid-template-columns: 1fr;
      margin-block-start: 1rem;
    }

    .index-pair {
      grid-template-columns: 1fr;
    }

    .index-stage {
      display: none;
    }

    .statement {
      margin-block: 2rem;
    }
  }
</style>
