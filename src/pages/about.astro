---
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import AnalogNote from '../components/AnalogNote.astro';
---

<BaseLayout title={`About | ${site.name}`} path="/about/">
  <div class="shell">
    <section class="poster-header" aria-labelledby="about-title" data-reveal>
      <div class="poster-field">
        <p class="kicker kicker-red">About / Statement</p>
        <h1 class="poster-headline poster" id="about-title">I learn<br />by making<br />things.</h1>
        <p class="poster-name kicker">{site.name}</p>
      </div>
      <div class="poster-panel">
        <p class="panel-name kicker">{site.name}</p>
        <p class="panel-copy serif-lede">Software engineer. Learning through projects, questions, writing, and books from many fields.</p>
      </div>
    </section>

    <section class="practice" aria-labelledby="practice-title">
      <div class="practice-copy">
        <h2 class="practice-title poster-section" id="practice-title" data-reveal>The practice</h2>
        <p>
          Indra is a software engineer. He learns by making things and reflecting through projects, questions,
          writing, and books from many fields.
        </p>
        <p>This site records work in progress and the lessons kept near the work.</p>
      </div>

      <div class="principles" aria-label="Principles" data-reveal>
        <AnalogNote label="Principle / 01">
          <p>Make the question smaller.</p>
        </AnalogNote>
        <AnalogNote label="Principle / 02">
          <p>Keep failure visible.</p>
        </AnalogNote>
        <AnalogNote label="Principle / 03">
          <p>Write down what changed.</p>
        </AnalogNote>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .poster-header {
    display: grid;
    grid-template-columns: minmax(0, 900fr) minmax(0, 428fr);
    min-height: 29.375rem;
  }

  .poster-field {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    padding: 1.75rem;
    background: var(--ink);
  }

  .poster-field p {
    margin: 0;
    color: var(--red-on-ink);
  }

  .poster-headline {
    margin: 0;
    color: var(--surface);
    font-size: clamp(3rem, 5.28vw, 4.75rem);
    line-height: 0.86;
    letter-spacing: -0.047em;
  }

  .poster-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.75rem;
    background: var(--red);
  }

  .poster-panel p {
    margin: 0;
  }

  .panel-name {
    color: var(--surface);
    font-family: var(--font-poster);
    font-size: 1.875rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .panel-copy {
    color: var(--surface);
    font-size: 1.5625rem;
    line-height: 1.25;
  }

  .practice {
    display: grid;
    grid-template-columns: minmax(0, 760fr) minmax(0, 522fr);
    gap: 2.875rem;
    padding-block: 2.75rem 4rem;
  }

  .practice-copy {
    min-width: 0;
    font-family: var(--font-serif);
    font-size: 1.375rem;
    line-height: 1.55;
  }

  .practice-title {
    margin: 0 0 1.375rem;
    font-size: 2.625rem;
    line-height: 1.1;
  }

  .practice-copy p {
    margin: 0 0 1.375rem;
  }

  .principles {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.125rem;
    min-width: 0;
  }

  .principles :global(.analog-note) {
    max-width: none;
    min-height: 9.6875rem;
    gap: 1.125rem;
  }

  .principles :global(.note-body) {
    font-family: var(--font-poster);
    font-size: 1.3125rem;
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.025em;
  }

  .principles :global(.note-mark) {
    margin-block-start: auto;
  }

  .principles :global(.analog-note:nth-child(2)) {
    rotate: 0.6deg;
    background: var(--red-soft);
  }

  .principles :global(.analog-note:nth-child(3)) {
    rotate: -0.4deg;
  }

  @media (max-width: 47.9375rem) {
    .poster-header {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 0.75rem;
      margin-block-start: 0.75rem;
    }

    .poster-field {
      min-height: 26.875rem;
      padding: 1.125rem;
    }

    .poster-headline {
      font-size: clamp(2.5rem, 12.82vw, 3.125rem);
      line-height: 0.9;
    }

    .poster-panel {
      padding: 0;
      background: transparent;
    }

    .panel-name {
      display: none;
    }

    .panel-copy {
      color: var(--ink);
      font-size: 1.25rem;
      line-height: 1.4;
    }

    .practice {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-block: 1.5rem 2.5rem;
    }

    .practice-copy {
      font-size: 1.1875rem;
    }

    .practice-title {
      font-size: 2rem;
    }

    .principles {
      gap: 0.75rem;
    }

    .principles :global(.analog-note) {
      min-height: 8.75rem;
      padding: 1rem;
    }

    .principles :global(.note-body) {
      font-size: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .principles :global(.analog-note) {
      rotate: none;
    }
  }
</style>
