---
import { getCollection } from 'astro:content';
import { visibleNewestFirst } from '../../lib/content';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import ArticleLead from '../../components/ArticleLead.astro';
import ArticleRow from '../../components/ArticleRow.astro';

const production = import.meta.env.PROD;
const articles = visibleNewestFirst(await getCollection('blog'), production);

const [lead, ...older] = articles;
---

<BaseLayout title={`Blog | ${site.name}`} path="/blog/">
  <div class="shell">
    <section class="header" aria-labelledby="blog-title" data-reveal>
      <h1 class="giant poster" id="blog-title">Blog /<br />Field notes</h1>
      <div class="context">
        <p class="kicker">Archive / open</p>
        <p class="serif-lede">Making software. Learning as I go.</p>
      </div>
    </section>

    <section class="lead-band" aria-label="Latest article" data-reveal>
      {lead ? <ArticleLead entry={lead} /> : <EmptyState message="No articles yet. Notes are being shaped." />}
    </section>

    {
      older.length > 0 && (
        <section class="archive" aria-labelledby="archive-title">
          <h2 class="archive-title poster-section" id="archive-title" data-reveal>Older notes / Still useful</h2>
          <ul class="archive-list">
            {older.map((entry) => (
              <ArticleRow entry={entry} />
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .header {
    display: grid;
    grid-template-columns: minmax(0, 930fr) minmax(0, 398fr);
    min-height: 18.75rem;
  }

  .giant {
    margin: 0;
    padding-block-start: 0.125rem;
    font-size: clamp(3.25rem, 6.25vw, 5.625rem);
    line-height: 0.84;
    letter-spacing: -0.044em;
  }

  .context {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem;
    background: var(--red);
  }

  .context p {
    margin: 0;
  }

  .context .kicker {
    color: var(--ink-on-red);
  }

  .context .serif-lede {
    color: var(--surface);
    font-size: 1.625rem;
    line-height: 1.25;
  }

  .lead-band {
    min-width: 0;
  }

  .archive {
    padding-block: 2.25rem 3.5rem;
  }

  .archive-title {
    margin: 0 0 1.25rem;
    font-size: 2.125rem;
    line-height: 1.1;
  }

  .archive-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 47.9375rem) {
    .header {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 0.75rem;
      margin-block: 0.75rem;
    }

    .giant {
      font-size: clamp(2.8125rem, 14.6vw, 3.5625rem);
      line-height: 0.86;
      letter-spacing: -0.045em;
    }

    .context {
      gap: 0.5rem;
      padding: 0.5rem 0;
      background: transparent;
    }

    .context .kicker {
      color: var(--red-text);
    }

    .context .serif-lede {
      color: var(--muted);
      font-size: 1.1875rem;
      line-height: 1.35;
    }

    .archive {
      padding-block: 1.5rem 2.5rem;
    }

    .archive-title {
      font-size: 2rem;
    }
  }
</style>
