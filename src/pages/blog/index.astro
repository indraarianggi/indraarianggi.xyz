---
import { getCollection } from 'astro:content';
import { visibleNewestFirst } from '../../lib/content';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import ArticleLead from '../../components/ArticleLead.astro';
import ArticleRow from '../../components/ArticleRow.astro';

const production = import.meta.env.PROD;
const articles = visibleNewestFirst(await getCollection('blog'), production);

const [lead, ...older] = articles;
---

<BaseLayout title={`Blog | ${site.name}`} path="/blog/">
  <div class="shell">
    <section class="header" aria-labelledby="blog-title">
      <h1 class="giant poster" id="blog-title">Blog / Field notes</h1>
      <div class="context">
        <p class="kicker">Archive / open</p>
        <p class="serif-lede">Making software. Learning as I go.</p>
      </div>
    </section>

    <section class="lead-band" aria-label="Latest article">
      {lead ? <ArticleLead entry={lead} /> : <EmptyState message="No articles yet. Notes are being shaped." />}
    </section>

    {
      older.length > 0 && (
        <section class="archive" aria-labelledby="archive-title">
          <h2 class="archive-title poster-section" id="archive-title">Older notes / Still useful</h2>
          <ul class="archive-list">
            {older.map((entry) => (
              <ArticleRow entry={entry} />
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
    gap: 0.5rem;
    margin-block-start: 1.25rem;
  }

  .giant {
    margin: 0;
    font-size: clamp(3.25rem, 7.4vw, 5.625rem);
    line-height: 0.84;
    letter-spacing: -0.044em;
  }

  .context {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--red);
    color: var(--surface);
  }

  .context p {
    margin: 0;
  }

  .context .kicker,
  .context .serif-lede {
    color: var(--ink-on-red);
  }

  .lead-band,
  .lead-band * {
    min-width: 0;
  }

  .lead-band {
    margin-block-start: 2rem;
  }

  .archive {
    margin-block-start: 2.5rem;
  }

  .archive-title {
    margin: 0;
  }

  .archive-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .archive {
    margin-block-end: 3.5rem;
  }

  .lead-band {
    margin-block-end: 0;
  }

  .archive {
    margin-block-start: 2.5rem;
  }

  @media (max-width: 47.9375rem) {
    .header {
      grid-template-columns: 1fr;
      margin-block-start: 1rem;
    }
  }
</style>
