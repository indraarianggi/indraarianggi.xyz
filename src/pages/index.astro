---
import { getCollection } from 'astro:content';
import { visibleNewestFirst } from '../lib/content';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import ProjectIndexRow from '../components/ProjectIndexRow.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import ArticleRow from '../components/ArticleRow.astro';
import ReadingDesk from '../components/ReadingDesk.astro';

const production = import.meta.env.PROD;

const workAll = await getCollection('work');
const blogAll = await getCollection('blog');
const booksAll = await getCollection('books');

const work = visibleNewestFirst(workAll, production);
const articles = visibleNewestFirst(blogAll, production);
const books = visibleNewestFirst(booksAll, production);

const featuredWork = work.filter((entry) => entry.data.featured).slice(0, 3);
const recentArticles = articles.slice(0, 4);
const currentBooks = books.filter((entry) => entry.data.status === 'reading').slice(0, 1);
const finishedBooks = books
  .filter((entry) => entry.data.status === 'finished')
  .slice(0, 2);
---

<BaseLayout title={site.title} path="/">
  <div class="shell">
    <section class="hero" aria-labelledby="home-headline">
      <div class="hero-field">
        <p class="hero-kicker kicker kicker-red">{site.name} / Software Engineer</p>
        <h1 class="hero-headline poster" id="home-headline">Making software. Learning as I go.</h1>
      </div>
      <div class="hero-note">
        <p class="hero-note-label kicker">Status / Learning</p>
        <p class="hero-note-copy serif-lede">I learn by making things.</p>
      </div>
    </section>

    <section class="selected-work" aria-labelledby="selected-work-title">
      <header class="section-poster">
        <p class="section-number poster" aria-hidden="true">01</p>
        <div>
          <p class="kicker kicker-red">Current index</p>
          <h2 class="section-poster-title poster-section" id="selected-work-title">Selected work</h2>
        </div>
      </header>

      {
        featuredWork.length > 0 ? (
          <div class="work-stage">
            <div class="work-index">
              {featuredWork.map((entry, index) => (
                <ProjectIndexRow entry={entry} index={index} variant="feature" />
              ))}
            </div>
            <div class="work-visual">
              <ProjectFeature entry={featuredWork[0]} index={0} />
            </div>
          </div>
        ) : (
          <EmptyState message="Nothing published here yet. I'm still building." />
        )
      }
    </section>

    <section class="writing-reading" aria-labelledby="writing-title">
      <div class="writing">
        <p class="kicker kicker-red">Recent writing</p>
        <h2 class="section-poster-title poster-section" id="writing-title">Notes from the work</h2>

        {
          recentArticles.length > 0 ? (
            <ul class="article-list">
              {recentArticles.map((entry) => (
                <ArticleRow entry={entry} showTopic={false} />
              ))}
            </ul>
          ) : (
            <EmptyState message="No articles yet. Notes are being shaped." />
          )
        }
      </div>

      <ReadingDesk current={currentBooks} finished={finishedBooks} />
    </section>

    <section class="closing" aria-label="Closing statement">
      <p class="closing-statement poster">Still learning. Still making.</p>
      <p class="closing-links kicker kicker-red">
        <a class="link-underline" href="/about/">About ↗</a>
        <span aria-hidden="true">&ensp;&ensp;</span>
        <a class="link-underline" href="/read/">Read ↗</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    gap: 0.5rem;
    margin-block-start: 1.25rem;
  }

  .hero-field {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem;
    background: var(--ink);
  }

  .hero-kicker {
    margin: 0;
    color: var(--red);
  }

  .hero-headline {
    margin: 0;
    color: var(--surface);
    font-size: clamp(2.75rem, 5.4vw, 4.75rem);
    line-height: 0.86;
    letter-spacing: -0.047em;
  }

  .hero-note {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--red);
    color: var(--surface);
  }

  .hero-note-label {
    margin: 0;
    color: var(--ink);
  }

  .hero-note-copy {
    margin: 0;
  }

  .selected-work {
    margin-block-start: 2.5rem;
  }

  .section-poster {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    border-top: 1px solid var(--ink);
    padding-block: 1rem;
  }

  .section-number {
    margin: 0;
    padding: 0.5rem 1rem;
    background: var(--ink);
    color: var(--surface);
    font-size: clamp(2.5rem, 4vw, 3.875rem);
    line-height: 0.9;
    letter-spacing: -0.048em;
  }

  .section-poster-title {
    margin: 0;
  }

  .work-stage {
    display: grid;
    grid-template-columns: minmax(0, 39rem) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    margin-block-start: 0.5rem;
  }

  .writing-reading {
    display: grid;
    grid-template-columns: minmax(0, 49rem) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    margin-block-start: 1.5rem;
  }

  .writing {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .article-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .closing {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-block: 3rem 3.5rem;
  }

  .closing-statement {
    margin: 0;
    font-size: clamp(2.5rem, 4.4vw, 3.4375rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .closing-links {
    margin: 0;
    font-size: 0.75rem;
  }

  .closing-links a {
    color: var(--red);
    text-decoration: none;
  }

  @media (max-width: 63.9375rem) {
    .writing-reading {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 47.9375rem) {
    .hero {
      grid-template-columns: 1fr;
      margin-block-start: 1rem;
    }

    .hero-field {
      padding: 1.25rem;
      gap: 4rem;
    }

    .work-stage {
      grid-template-columns: 1fr;
    }

    .work-visual {
      display: none;
    }

    .closing {
      margin-block: 2rem;
    }
  }
</style>
