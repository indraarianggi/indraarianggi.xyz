---
import { getCollection } from 'astro:content';
import { visibleNewestFirst } from '../lib/content';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import ArticleRow from '../components/ArticleRow.astro';
import ReadingDesk from '../components/ReadingDesk.astro';

const production = import.meta.env.PROD;

const workAll = await getCollection('work');
const blogAll = await getCollection('blog');
const booksAll = await getCollection('books');

const work = visibleNewestFirst(workAll, production);
const articles = visibleNewestFirst(blogAll, production);
const books = visibleNewestFirst(booksAll, production);

const featuredWork = work.filter((entry) => entry.data.featured).slice(0, 3);
const recentArticles = articles.slice(0, 3);
const currentBooks = books.filter((entry) => entry.data.status === 'reading').slice(0, 1);
const finishedBooks = books
  .filter((entry) => entry.data.status === 'finished')
  .slice(0, 2);
---

<BaseLayout title={site.title} path="/">
  <div class="shell">
    <section class="hero" aria-labelledby="home-headline">
      <div class="hero-field">
        <p class="hero-kicker kicker kicker-red">{site.name} / Software Engineer</p>
        <h1 class="hero-headline poster" id="home-headline">
          <span>Making software.</span>
          <span>Learning as I go.</span>
        </h1>
      </div>
      <div class="hero-note">
        <p class="hero-note-label kicker">Note / 01</p>
        <p class="hero-note-copy">I build to understand. I write to remember. I read because useful ideas rarely stay inside one field.</p>
        <span class="hero-note-mark" aria-hidden="true">////</span>
      </div>
    </section>

    <section class="selected-work" aria-labelledby="selected-work-title" data-reveal>
      <header class="section-poster">
        <p class="section-number poster" aria-hidden="true">01</p>
        <div>
          <p class="kicker kicker-red">Current index</p>
          <h2 class="section-poster-title poster-section" id="selected-work-title">Selected work</h2>
        </div>
      </header>

      {
        featuredWork.length > 0 ? (
          <ProjectIndex entries={featuredWork} variant="feature" />
        ) : (
          <EmptyState message="Nothing published here yet. I'm still building." />
        )
      }
    </section>

    <section class="writing-reading" aria-labelledby="writing-title" data-reveal>
      <div class="writing">
        <p class="kicker kicker-red">Recent writing</p>
        <h2 class="section-poster-title poster-section" id="writing-title">Notes from the work</h2>

        {
          recentArticles.length > 0 ? (
            <ul class="article-list">
              {recentArticles.map((entry) => (
                <ArticleRow entry={entry} showTopic={false} />
              ))}
            </ul>
          ) : (
            <EmptyState message="No articles yet. Notes are being shaped." />
          )
        }
      </div>

      <ReadingDesk current={currentBooks} finished={finishedBooks} />
    </section>

    <section class="closing" aria-label="Closing statement" data-reveal>
      <p class="closing-statement poster">Still learning.<br />Still making.</p>
      <p class="closing-links kicker kicker-red">
        <a class="link-underline" href="/about/">About ↗</a>
        <span aria-hidden="true">&ensp;&ensp;</span>
        <a class="link-underline" href="/read/">Read ↗</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 900fr) minmax(0, 428fr);
    min-height: 31.25rem;
    border-bottom: 3px solid var(--ink);
  }

  .hero-field {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 6rem;
    padding: 1.75rem;
    background: var(--ink);
    container-type: inline-size;
  }

  .hero-kicker {
    margin: 0;
    color: var(--red-on-ink);
  }

  .hero-headline {
    margin: 0;
    color: var(--surface);
    font-size: clamp(2.5rem, 8.95cqw, 4.75rem);
    line-height: 0.86;
    letter-spacing: -0.047em;
    text-wrap: initial;
  }

  .hero-headline span {
    display: block;
    animation: poster-in 650ms var(--ease-out) both;
  }

  .hero-headline span + span {
    animation-delay: 70ms;
  }

  .hero-note {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.75rem;
    background: var(--red);
  }

  .hero-note-label {
    margin: 0;
    color: var(--ink-on-red);
  }

  .hero-note-copy {
    margin: 0;
    color: var(--surface);
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 1.95vw, 1.75rem);
    line-height: 1.2;
    text-wrap: pretty;
    animation: poster-in 650ms 140ms var(--ease-out) both;
  }

  .hero-note-mark {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    letter-spacing: 0.25em;
  }

  .selected-work {
    margin-block-start: 3.375rem;
  }

  .section-poster {
    display: grid;
    grid-template-columns: 9.75rem minmax(0, 1fr);
    align-items: stretch;
    min-height: 8.625rem;
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .section-poster > div {
    align-self: center;
    padding: 1.25rem 1.75rem;
  }

  .section-poster .kicker {
    margin-bottom: 0.5rem;
  }

  .section-number {
    display: grid;
    place-items: center;
    margin: 0;
    background: var(--red);
    color: var(--surface);
    font-size: 3.875rem;
    letter-spacing: -0.048em;
  }

  .section-poster-title {
    margin: 0;
  }

  .writing-reading {
    display: grid;
    grid-template-columns: minmax(0, 780fr) minmax(0, 548fr);
    align-items: stretch;
    min-height: 30rem;
    margin-block-start: 2rem;
  }

  .writing {
    padding: 1.75rem 1.75rem 1.75rem 0;
  }

  .writing > .kicker {
    margin-bottom: 0.75rem;
  }

  .writing .poster-section {
    margin-bottom: 1.75rem;
    font-size: clamp(1.75rem, 3.055vw, 2.75rem);
  }

  .article-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .closing {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 15.625rem;
    border-top: 1px solid var(--ink);
    padding-block: 3rem;
  }

  .closing-statement {
    margin: 0;
    font-size: clamp(2.5rem, 3.82vw, 3.4375rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .closing-links {
    margin: 0;
    white-space: nowrap;
    font-size: 0.75rem;
  }

  .closing-links a {
    color: var(--red-text);
    text-decoration: none;
  }

  @keyframes poster-in {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-headline span,
    .hero-note-copy {
      animation: none;
    }
  }

  @media (max-width: 63.9375rem) and (min-width: 48rem) {
    .hero {
      min-height: 27rem;
    }

    .hero-headline {
      font-size: 10cqw;
    }
  }

  @media (max-width: 47.9375rem) {
    .hero {
      display: flex;
      flex-direction: column;
      gap: 1.125rem;
      min-height: 32.5rem;
      padding: 1.5rem;
      background: var(--ink);
    }

    .hero-field {
      display: contents;
    }

    .hero-kicker {
      font-size: 0.5625rem;
      letter-spacing: 0.055em;
    }

    .hero-headline {
      font-size: clamp(2.375rem, 12.82vw, 3.125rem);
      line-height: 0.9;
    }

    .hero-note {
      display: block;
      padding: 0;
      background: transparent;
    }

    .hero-note-label,
    .hero-note-mark {
      display: none;
    }

    .hero-note-copy {
      font-size: 1.125rem;
      line-height: 1.35;
    }

    .selected-work {
      margin-block-start: 1.5rem;
    }

    .section-poster {
      display: block;
      min-height: 0;
      border: 0;
    }

    .section-poster > div {
      padding: 0 0 0.875rem;
    }

    .section-number,
    .section-poster .kicker {
      display: none;
    }

    .section-poster-title {
      font-size: clamp(1.75rem, 9.74vw, 2.375rem);
    }

    .writing-reading {
      grid-template-columns: 1fr;
      margin-block-start: 0;
    }

    .writing {
      padding: 1.5rem 0 2rem;
    }

    .closing {
      flex-wrap: wrap;
      min-height: 0;
      margin-block-start: 1.5rem;
      padding-block: 2rem;
    }
  }
</style>
