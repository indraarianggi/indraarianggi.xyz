---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout title={`Page not found | ${site.name}`} path="/404/" mainClass="is-centred">
  <div class="lost">
    <p class="numeral" aria-hidden="true">404</p>
    <h1 class="line">You've wandered past the edge of the garden.</h1>
  </div>
</BaseLayout>

<style>
  /* No links: the sidebar is the way out. */
  :global(.page > main.is-centred) {
    display: grid;
    align-content: center;
    /* Canvas centres the pair in the full viewport, not in the padded content box. */
    padding-block: 0;
  }

  .numeral {
    margin-inline-start: -0.04em;
    color: var(--bar);
    font-family: var(--font-serif);
    font-size: clamp(8rem, 40vw, 18.75rem);
    font-weight: 300;
    /* Canvas draws the numeral at the font's default optical size (460 wide). */
    font-optical-sizing: none;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .line {
    padding-inline-start: 0.375rem;
    font-family: var(--font-serif);
    font-size: 2rem;
    /* Canvas: a 32px line box on one line; it can wrap on mobile, so that size keeps 1.2. */
    line-height: 1;
  }

  @media (max-width: 47.9375rem) {
    .line {
      font-size: 1.5rem;
      line-height: 1.2;
    }
  }
</style>
