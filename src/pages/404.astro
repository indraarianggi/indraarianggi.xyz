---
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`Page not found | ${site.name}`} path="/404/">
  <div class="shell">
    <section class="misprint" aria-labelledby="notfound-title" data-reveal>
      <p class="giant-number poster" aria-hidden="true">404</p>
      <div class="message-panel">
        <p class="kicker">Misprint / Page not found</p>
        <h1 class="message poster" id="notfound-title">This page is not in the index.</h1>
        <ul class="recovery">
          <li><a class="recovery-link kicker" href="/">Home ↗</a></li>
          <li><a class="recovery-link kicker" href="/work/">Work ↗</a></li>
          <li><a class="recovery-link kicker" href="/blog/">Blog ↗</a></li>
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .misprint {
    display: grid;
    grid-template-columns: minmax(0, 840fr) minmax(0, 488fr);
    min-height: 37.5rem;
  }

  .giant-number {
    margin: 0;
    font-size: clamp(10rem, 23.6vw, 21.25rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
  }

  .message-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4rem;
    padding: 1.75rem;
    background: var(--red);
    color: var(--ink-on-red);
  }

  .message-panel p {
    margin: 0;
  }

  .message {
    margin: 0;
    color: var(--ink-on-red);
    font-size: clamp(1.75rem, 2.92vw, 2.625rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .recovery {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .recovery-link {
    color: var(--ink-on-red);
    text-decoration: none;
    display: inline-block;
    padding-block: 0.25rem;
    font-size: 0.8125rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .recovery-link:hover {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.3em;
    }
  }

  @media (max-width: 47.9375rem) {
    .misprint {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .giant-number {
      padding-block: 0.75rem 1.25rem;
      font-size: 9.0625rem;
      line-height: 0.95;
    }

    .message-panel {
      min-height: 20.625rem;
      gap: 2.5rem;
      padding: 1.125rem;
    }

    .message {
      font-size: 2.125rem;
    }

    .recovery {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
    }

    .recovery-link {
      font-size: 0.6875rem;
    }
  }
</style>
