---
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import KineticText from '../components/KineticText.astro';
---

<BaseLayout title={`Page not found | ${site.name}`} path="/404/">
  <section class="dropped shell" data-scene="Dropped frame" aria-labelledby="notfound-title">
    <p class="drop-line label dim">
      <span>Dropped frame</span>
      <span class="keyframe" aria-hidden="true"></span>
      <span>Page not found</span>
    </p>
    <p class="drop-number display" aria-hidden="true">404</p>
    <div class="drop-copy">
      <KineticText as="h1" id="notfound-title" split="words" delay={300} text="This frame is not in the reel." class="drop-title display" />
      <ul class="recovery label">
        <li><a class="text-link" href="/">Home</a></li>
        <li><a class="text-link" href="/work/">Work</a></li>
        <li><a class="text-link" href="/blog/">Blog</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .dropped {
    display: grid;
    gap: 2rem;
    padding-block: 2rem 5rem;
    container-type: inline-size;
  }

  .drop-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
  }

  .drop-number {
    margin: 0;
    font-size: 40cqi;
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--signal);
  }

  /* One stutter on arrival, stepped like a frame the decoder lost. */
  @media (prefers-reduced-motion: no-preference) {
    .drop-number {
      animation: stutter 600ms steps(1, end) both;
    }
  }

  @keyframes stutter {
    0% { opacity: 0; }
    15% { opacity: 1; transform: translateX(-2%); }
    30% { opacity: 0.2; transform: translateX(3%); clip-path: inset(30% 0 40% 0); }
    45% { opacity: 1; transform: translateX(-1%); clip-path: none; }
    60% { opacity: 1; transform: translateX(1.5%) skewX(-6deg); }
    75%, 100% { opacity: 1; transform: none; }
  }

  .drop-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: end;
  }

  .dropped :global(.drop-title) {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 4rem);
  }

  .recovery {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .recovery a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  @media (max-width: 47.9375rem) {
    .drop-copy {
      grid-template-columns: 1fr;
    }
  }
</style>
