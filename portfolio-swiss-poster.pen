              "gap": 28,
              "children": [
                {
                  "type": "text",
                  "id": "Dh0NL",
                  "name": "Design Notice",
                  "fill": "$ink-muted",
                  "content": "[DESIGN-ONLY REPRESENTATIVE DATA — ESSAY SAMPLE FOR TYPOGRAPHY EVALUATION]",
                  "fontFamily": "$font-mono",
                  "fontSize": 11,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "I6rX7X",
                  "name": "Section 1",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 10,
                  "children": [
                    {
                      "type": "text",
                      "id": "oTg89",
                      "name": "H2",
                      "fill": "$ink-primary",
                      "content": "1. The Limits of Happy-Path Testing",
                      "fontFamily": "$font-display",
                      "fontSize": 22,
                      "fontWeight": "bold"
                    },
                    {
                      "type": "text",
                      "id": "mTEdI",
                      "name": "Body 1",
                      "fill": "$ink-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Most automated test suites verify only predetermined sequences where network packets arrive in order, disks flush instantaneously, and clocks never skew. In distributed systems, this creates a false sense of security.",
                      "fontFamily": "$font-display",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "LOxsd",
                  "name": "Section 2",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 14,
                  "children": [
                    {
                      "type": "text",
                      "id": "eyus9",
                      "name": "H2",
                      "fill": "$ink-primary",
                      "content": "2. Formulating State Machine Invariants",
                      "fontFamily": "$font-display",
                      "fontSize": 22,
                      "fontWeight": "bold"
                    },
                    {
                      "type": "text",
                      "id": "QbLuM",
                      "name": "Body 2",
                      "fill": "$ink-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "An invariant is an assertion about the state of the universe that must hold true after every valid state transition. When designing a state machine, the invariants should precede the implementation code.",
                      "fontFamily": "$font-display",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "fTql5",
                      "name": "Signature Margin Note: Invariant Definition",
                      "width": "fill_container",
                      "fill": "$surface-subtle",
