          "children": [
            {
              "type": "frame",
              "id": "VMTHq",
              "name": "Reading Measure Column (68ch)",
              "width": 960,
              "layout": "vertical",
              "gap": 32,
              "children": [
                {
                  "type": "text",
                  "id": "Y9OzPZ",
                  "name": "Design Notice",
                  "fill": "$ink-muted",
                  "content": "[DESIGN-ONLY REPRESENTATIVE DATA — ARCHITECTURAL CASE STUDY MOCKUP]",
                  "fontFamily": "$font-mono",
                  "fontSize": 11,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "CmFOQ",
                  "name": "Section: Context",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "wFWhM",
                      "name": "Context H2",
                      "fill": "$ink-primary",
                      "content": "1. Context & Operational Background",
                      "fontFamily": "$font-display",
                      "fontSize": 22,
                      "fontWeight": "bold"
                    },
                    {
                      "type": "text",
                      "id": "dQb0v",
                      "name": "Context Body",
                      "fill": "$ink-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "In high-throughput sensor telemetry platforms, ingest pipelines face bursts exceeding 300,000 events per second. Traditional centralized transactional databases introduce network hops and lock contention that compromise durability guarantees during regional network degradation.",
                      "fontFamily": "$font-display",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "bvoHv",
                  "name": "Section: Problem",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "REhBd",
                      "name": "Problem H2",
                      "fill": "$ink-primary",
                      "content": "2. Problem Definition & Bottlenecks",
                      "fontFamily": "$font-display",
                      "fontSize": 22,
                      "fontWeight": "bold"
                    },
                    {
                      "type": "text",
                      "id": "T5XKt",
                      "name": "Problem Body",
                      "fill": "$ink-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The existing broker architecture suffered from three distinct failure modes: non-deterministic replication lag during leader failover, excessive GC pauses caused by buffer allocations in the write path, and disk fsync stalls during log compaction.",
                      "fontFamily": "$font-display",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "xmq7m",
                  "name": "Section: Decisions",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "Xo9wE",
                      "name": "Decisions H2",
                      "fill": "$ink-primary",
                      "content": "3. Architecture & Key Decisions",
                      "fontFamily": "$font-display",
                      "fontSize": 22,
                      "fontWeight": "bold"
                    },
                    {
                      "type": "text",
                      "id": "qWYFT",
                      "name": "Decisions Body",
                      "fill": "$ink-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "We chose an embedded Raft implementation coupled directly with a write-ahead log on BadgerDB. By isolating state transitions into pure state machines, we made every mutation verifiable through deterministic replay.",
                      "fontFamily": "$font-display",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "tJ7bF",
                      "name": "Subsection: Raft Log Replication",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 8,
                      "padding": [
                        8,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "tawCj",
                          "name": "Sub H3",
                          "fill": "$ink-primary",
                          "content": "3.1 Raft Log Replication Topology",
                          "fontFamily": "$font-display",
                          "fontSize": 18,
                          "fontWeight": "bold"
                        },
                        {
                          "type": "text",
                          "id": "hGKkP",
                          "name": "Sub Body",
                          "fill": "$ink-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Entries are committed once a quorum acknowledges receipt into non-volatile storage. Heartbeats and log entries travel over pipelined gRPC streams with pooled ring buffers.",
                          "fontFamily": "$font-display",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        }
                      ]
