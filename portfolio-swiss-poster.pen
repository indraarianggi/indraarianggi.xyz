            {
              "type": "text",
              "id": "m0AiXY",
              "name": "H1 Title",
              "fill": "$ink-primary",
              "content": "Architectural Invariants and Verifiable State Machines",
              "fontFamily": "$font-display",
              "fontSize": 34,
              "fontWeight": "bold"
            },
            {
              "type": "text",
              "id": "BMLej",
              "name": "Standfirst",
              "fill": "$ink-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Why formulating explicit mathematical invariants and testing through adversarial event interleaving transforms software systems from fragile heuristics into verifiable engines.",
              "fontFamily": "$font-display",
