                    {
                      "type": "text",
                      "id": "dFko5",
                      "name": "H2",
                      "fill": "$ink-primary",
                      "content": "4. Practical Implementation Guidelines",
                      "fontFamily": "$font-display",
                      "fontSize": 22,
                      "fontWeight": "bold"
                    },
                    {
                      "type": "text",
                      "id": "F7yIjH",
                      "name": "Body 4",
                      "fill": "$ink-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Start by writing invariant assertion checks directly into the state transition handlers. In debug and test builds, assert all invariants on every applied transition.",
                      "fontFamily": "$font-display",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
