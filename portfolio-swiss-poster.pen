                              "fill": "$vermilion",
                              "content": "MARGIN NOTE [§2.1 SAFETY PROPERTIES]",
                              "fontFamily": "$font-mono",
                              "fontSize": 11,
                              "fontWeight": "bold"
                            },
                            {
                              "type": "text",
                              "id": "iEB8o",
                              "name": "Content",
                              "fill": "$ink-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Safety property: nothing bad happens. Liveness property: something good eventually happens. Invariants verify safety deterministically at each step.",
                              "fontFamily": "$font-sans",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "zjwse",
                  "name": "Section 3",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 10,
                  "children": [
                    {
                      "type": "text",
                      "id": "CyRtY",
                      "name": "H2",
                      "fill": "$ink-primary",
                      "content": "3. Generating Adversarial Interleavings",
                      "fontFamily": "$font-display",
                      "fontSize": 22,
                      "fontWeight": "bold"
                    },
                    {
                      "type": "text",
                      "id": "VnirS",
                      "name": "Body 3",
                      "fill": "$ink-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "By modeling asynchronous message exchanges as discrete events inside a simulated scheduler, we can reorder, duplicate, and delay messages deterministically.",
                      "fontFamily": "$font-display",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "v0rKzE",
                  "name": "Section 4",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 10,
